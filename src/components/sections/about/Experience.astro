---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import ResumeDropdown from "../../elements/ResumeDropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

// content
const experience = [
    { 
        title: "Diseño Gráfico & Branding",
        place: "Freelance",
        period: "Actualidad",
        text: "Creo identidades visuales y soluciones gráficas para marcas que necesitan definir, mejorar o renovar su imagen."
    }, 
    { 
        title: "Identidad Visual",
        place: "Proyectos de Marca",
        period: "Actualidad",
        text: "Trabajo el concepto, la dirección visual, el logotipo y los diferentes elementos que forman una identidad coherente y reconocible."
    }, 
    { 
        title: "Diseño para Digital",
        place: "Proyectos Freelance",
        period: "Actualidad",
        text: "Diseño piezas para redes sociales, páginas web y otros soportes digitales, manteniendo una comunicación visual clara y consistente."
    }, 
    { 
        title: "Diseño Gráfico",
        place: "Proyectos Creativos",
        period: "Actualidad",
        text: "Desarrollo propuestas gráficas combinando composición, tipografía, color e imagen para convertir ideas en soluciones visuales."
    },
]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Experience</Heading>
    <div class="flex flex-col gap-4">  
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                experience.map((i) => (
                    <ResumeDropdown title={i.title} place={i.place} period={i.period} text={i.text} />
                ))
            }
        </Container>
        <ContainerBottom />
    </div>

</Container>

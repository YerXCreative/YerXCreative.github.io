---
import Layout from "../../layouts/Layout.astro";
import Work from "../../components/elements/Work.astro";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
    const works = await getCollection("works", ({ data }) => !data.isDraft);
    return paginate(works, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout
    title="Proyectos | YerxCreative"
    description="Una selección de proyectos de Yeray Díaz en diseño web, campañas digitales e identidad visual."
>
    <main class="max-w-7xl mx-auto px-6 md:px-10 pt-32 pb-20">

        <!-- Cabecera -->
        <header class="mb-16 md:mb-20">
            <div class="flex items-end justify-between gap-6 mb-6">
                <span class="text-[#0066FF] text-sm font-bold tracking-[0.2em]">
                    03
                </span>

                <span class="hidden md:block text-neutral-500 text-sm">
                    YerxCreative / Proyectos
                </span>
            </div>

            <div class="border-t border-[#292929] pt-8">
                <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-[-0.05em] leading-[0.9] text-white max-w-5xl">
                    Proyectos
                </h1>

                <p class="mt-8 max-w-2xl text-neutral-400 text-lg md:text-xl leading-relaxed">
                    Una selección de trabajos en diseño web, campañas digitales,
                    identidad visual y proyectos creativos.
                </p>
            </div>
        </header>

        <!-- Proyectos -->
        <section aria-label="Proyectos seleccionados">
            <div class="grid md:grid-cols-2 gap-x-8 gap-y-16 md:gap-y-20">
                {page.data.map((work) => (
                    <Work
                        slug={work.data.slug}
                        featuredImage={work.data.featuredImage}
                        title={work.data.title}
                        client={work.data.client}
                        category={work.data.category}
                    />
                ))}
            </div>
        </section>

        <!-- Paginación -->
        {page.totalPages > 1 && (
            <nav
                aria-label="Paginación de proyectos"
                class="mt-20 pt-8 border-t border-[#292929] flex items-center justify-between"
            >
                {page.url.prev ? (
                    <a
                        href={page.url.prev}
                        class="text-white hover:text-[#0066FF] transition-colors text-sm font-medium"
                    >
                        ← Anterior
                    </a>
                ) : (
                    <span></span>
                )}

                <span class="text-neutral-500 text-sm">
                    {page.currentPage} / {page.totalPages}
                </span>

                {page.url.next ? (
                    <a
                        href={page.url.next}
                        class="text-white hover:text-[#0066FF] transition-colors text-sm font-medium"
                    >
                        Siguiente →
                    </a>
                ) : (
                    <span></span>
                )}
            </nav>
        )}

    </main>
</Layout>
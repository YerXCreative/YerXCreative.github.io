---
import peter3 from "../../../assets/images/peter3.jpg";
---

<section class="bg-black text-white">

    <!-- CABECERA -->

    <div class="px-6 md:px-12 lg:px-20 pt-24 md:pt-32">

        <div class="max-w-[1400px] mx-auto">

            <header>

                <p class="uppercase tracking-[0.2em] text-sm text-neutral-500 mb-6">
                    YerxCreative / Sobre mí
                </p>

                <div class="border-t border-[#292929] pt-8">

                    <h1 class="text-[clamp(5rem,10vw,9rem)] font-bold max-w-6xl leading-[1]">
                        Sobre mí.
                    </h1>

                </div>

            </header>

        </div>

    </div>


    <!-- PRESENTACIÓN -->

    <section class="px-6 md:px-12 lg:px-20 py-24 md:py-32">

        <div class="max-w-[1400px] mx-auto grid grid-cols-2 gap-20 lg:gap-28 items-start">

            <!-- TEXTO -->

            <div class="flex flex-col gap-10">

                <p class="text-4xl md:text-5xl leading-[1.1] text-white max-w-3xl">
                    Diseño, proyectos y creatividad.
                </p>

                <p class="text-xl leading-relaxed text-neutral-400 max-w-2xl">
                    Soy Yeray Díaz Cortina, diseñador digital y de proyectos.
                    Trabajo en diseño web, campañas digitales, identidad visual
                    y gestión de proyectos.
                </p>

                <p class="text-xl leading-relaxed text-neutral-400 max-w-2xl">
                    Me interesa crear soluciones que funcionen, que tengan
                    personalidad y que sean capaces de convertir una idea
                    en algo que la gente pueda entender y recordar.
                </p>

            </div>


            <!-- IMAGEN -->

            <div class="flex justify-end">

                <div class="relative w-full max-w-[520px]">

                    <div class="absolute right-[-12px] bottom-[-12px] w-full h-full border-r-2 border-b-2 border-[#0066FF]">
                    </div>

                    <div class="relative bg-[#111111] p-3">

                        <img
                            src={peter3.src}
                            alt="Yeray Díaz Cortina, diseñador digital y de proyectos"
                            class="w-full h-auto object-cover"
                        />

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- LO QUE HAGO -->

    <section class="px-6 md:px-12 lg:px-20 py-24 md:py-32 border-t border-[#292929]">

        <div class="max-w-[1400px] mx-auto">

            <div class="grid grid-cols-[0.7fr_1.3fr] gap-20">

                <div>

                    <p class="uppercase tracking-[0.2em] text-sm text-neutral-500">
                        Lo que hago
                    </p>

                </div>


                <div class="border-t border-[#292929]">

                    <div class="py-7 border-b border-[#292929]">
                        <h2 class="text-4xl md:text-5xl">
                            Identidad visual
                        </h2>
                    </div>

                    <div class="py-7 border-b border-[#292929]">
                        <h2 class="text-4xl md:text-5xl">
                            Diseño web
                        </h2>
                    </div>

                    <div class="py-7 border-b border-[#292929]">
                        <h2 class="text-4xl md:text-5xl">
                            Campañas digitales
                        </h2>
                    </div>

                    <div class="py-7 border-b border-[#292929]">
                        <h2 class="text-4xl md:text-5xl">
                            Diseño gráfico
                        </h2>
                    </div>

                    <div class="py-7 border-b border-[#292929]">
                        <h2 class="text-4xl md:text-5xl">
                            Gestión de proyectos
                        </h2>
                    </div>

                    <div class="py-7 border-b border-[#292929]">
                        <h2 class="text-4xl md:text-5xl">
                            Cliente y comunicación
                        </h2>
                    </div>

                    <div class="py-7 border-b border-[#292929]">
                        <h2 class="text-4xl md:text-5xl">
                            Herramientas creativas
                        </h2>
                    </div>

                    <div class="py-7 border-b border-[#292929]">
                        <h2 class="text-4xl md:text-5xl">
                            IA aplicada al diseño
                        </h2>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CIERRE -->

    <section class="px-6 md:px-12 lg:px-20 py-28 md:py-40">

        <div class="max-w-[1400px] mx-auto">

            <div class="border-t border-[#292929] pt-10">

                <p class="text-5xl md:text-7xl lg:text-8xl leading-[1.05] max-w-6xl">
                    Diseño con intención.
                </p>

                <p class="text-5xl md:text-7xl lg:text-8xl leading-[1.05] max-w-6xl text-[#0066FF]">
                    Creatividad con criterio.
                </p>

            </div>

        </div>

    </section>

</section>
---
import Layout from "../../layouts/Layout.astro";
import "../../styles/markdown.css";

import type { GetStaticPaths } from "astro";
import type { ImageMetadata } from "astro";
import { render, getCollection } from "astro:content";

import ImageContainer from "../../components/elements/ImageContainer.astro";

export const getStaticPaths = (async () => {
    const works = await getCollection("works", ({ data }) => !data.isDraft);

    return works.map((work) => ({
        params: { page: work.data.slug },
        props: { work },
    }));
}) satisfies GetStaticPaths;

const { work } = Astro.props;
const { Content } = await render(work);

const {
    title,
    client,
    category,
    services,
    year,
    description,
} = work.data;

const imageModules = import.meta.glob(
    "../../content/images/**/*.{jpg,jpeg,png,webp,avif}",
    {
        eager: true,
        import: "default",
    }
);

const projectImages = Object.entries(imageModules)
    .filter(([path]) => path.includes(`/images/${work.data.slug}/`))
    .sort(([pathA], [pathB]) => {
        const fileA = pathA.split("/").pop() ?? "";
        const fileB = pathB.split("/").pop() ?? "";

        const numberA = parseInt(fileA, 10);
        const numberB = parseInt(fileB, 10);

        if (!Number.isNaN(numberA) && !Number.isNaN(numberB)) {
            return numberA - numberB;
        }

        return fileA.localeCompare(fileB);
    })
    .map(([, image]) => image as ImageMetadata);
---

<Layout
    title={`${title} | YerxCreative`}
    description={description}
>
    <main class="bg-black text-white px-5 sm:px-6 md:px-12 lg:px-20 pt-20 sm:pt-24 md:pt-28 pb-14 md:pb-16">

        <div class="max-w-[1400px] mx-auto">

            <!-- CABECERA -->

            <header class="mb-10 sm:mb-12 md:mb-14">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-500 mb-5">
                    YerxCreative / Proyectos
                </p>

                <div class="border-t border-[#292929] pt-6">

                    <p class="text-[#0066FF] text-xs md:text-sm uppercase tracking-[0.18em] font-semibold mb-4">
                        {category}
                    </p>

                    <h1
                        class="font-bold uppercase max-w-6xl text-[clamp(4rem,8vw,9rem)] leading-[0.82] tracking-[-0.02em]"
                    >
                        {title}
                    </h1>

                    <!-- VOLVER A PROYECTOS -->

                    <div class="mt-5 sm:mt-6">

                        <a
                            href="/works"
                            class="group inline-flex items-center gap-3 text-[#0066FF] text-sm sm:text-base font-semibold"
                        >

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                class="w-5 h-5 group-hover:-translate-x-1 transition-transform"
                                aria-hidden="true"
                            >
                                <path d="M19 12H5" />
                                <path d="m11 18-6-6 6-6" />
                            </svg>

                            <span class="border-b border-[#0066FF] pb-1">
                                Todos los proyectos
                            </span>

                        </a>

                    </div>

                </div>

            </header>


            <!-- INFORMACIÓN DEL PROYECTO -->

            <section class="border-y border-[#292929] py-6 md:py-7 mb-8 md:mb-10">

                <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-5 md:gap-10">

                    <div>
                        <p class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-1.5">
                            Cliente
                        </p>

                        <p class="text-sm md:text-base text-white">
                            {client}
                        </p>
                    </div>

                    <div>
                        <p class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-1.5">
                            Categoría
                        </p>

                        <p class="text-sm md:text-base text-white">
                            {category}
                        </p>
                    </div>

                    <div>
                        <p class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-1.5">
                            Servicios
                        </p>

                        <p class="text-sm md:text-base text-white">
                            {services}
                        </p>
                    </div>

                    <div>
                        <p class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-1.5">
                            Año
                        </p>

                        <p class="text-sm md:text-base text-white">
                            {year}
                        </p>
                    </div>

                </div>

            </section>


            <!-- PROYECTO + IMÁGENES -->

            <section class="grid grid-cols-1 lg:grid-cols-[1.6fr_0.9fr] gap-8 lg:gap-14 mb-8 md:mb-10">

                <!-- IMÁGENES -->

                {projectImages.length > 0 && (

                    <div class="grid grid-cols-2 gap-3 md:gap-4">

                        {projectImages.map((image, index) => (

                            <div class="w-full overflow-hidden bg-[#0A0A0A] rounded-xl">

                                <ImageContainer
                                    src={image}
                                    alt={`${title} — imagen ${index + 1}`}
                                    class="w-full h-auto"
                                />

                            </div>

                        ))}

                    </div>

                )}


                <!-- EL PROYECTO -->

                <div class="lg:pt-0">

                    <p class="text-xs uppercase tracking-[0.18em] text-neutral-500 mb-4">
                        El proyecto
                    </p>

                    <p class="font-bold text-[clamp(1.7rem,2.7vw,3.2rem)] leading-[0.98] tracking-[-0.02em] text-white max-w-5xl">
                        {description}
                    </p>

                </div>

            </section>


            <!-- CONTENIDO DEL PROYECTO -->

            <article class="markdown-content max-w-4xl mx-auto py-0">

                <Content />

            </article>

        </div>

    </main>


    <!-- LIGHTBOX -->

    <div
        id="image-lightbox"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 p-4 sm:p-6"
        aria-hidden="true"
    >

        <button
            id="lightbox-close"
            type="button"
            class="absolute top-5 right-5 sm:top-7 sm:right-7 w-10 h-10 rounded-full border border-white/20 text-white flex items-center justify-center hover:border-[#0066FF] hover:text-[#0066FF] transition-colors"
            aria-label="Cerrar imagen"
        >

            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="w-5 h-5"
                aria-hidden="true"
            >
                <path d="M6 6l12 12" />
                <path d="M18 6L6 18" />
            </svg>

        </button>

        <img
            id="lightbox-image"
            src=""
            alt=""
            class="max-w-full max-h-[90vh] object-contain"
        />

    </div>


    <script>
        const lightbox = document.getElementById("image-lightbox");
        const lightboxImage = document.getElementById("lightbox-image");
        const lightboxClose = document.getElementById("lightbox-close");

        function closeLightbox() {
            if (!lightbox || !lightboxImage) return;

            lightbox.classList.add("hidden");
            lightbox.classList.remove("flex");
            lightbox.setAttribute("aria-hidden", "true");
            lightboxImage.setAttribute("src", "");
        }

        function openLightbox(src, alt) {
            if (!lightbox || !lightboxImage) return;

            lightboxImage.setAttribute("src", src);
            lightboxImage.setAttribute("alt", alt);

            lightbox.classList.remove("hidden");
            lightbox.classList.add("flex");
            lightbox.setAttribute("aria-hidden", "false");
        }

        document.addEventListener("click", (event) => {
            const target = event.target as HTMLElement | null;

            if (!target) return;

            const image = target.closest("[data-lightbox-image]");

            if (!image) return;

            const src = image.getAttribute("data-lightbox-image");
            const alt = image.getAttribute("alt") ?? "";

            if (src) {
                openLightbox(src, alt);
            }
        });

        lightboxClose?.addEventListener("click", closeLightbox);

        lightbox?.addEventListener("click", (event) => {
            if (event.target === lightbox) {
                closeLightbox();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                closeLightbox();
            }
        });
    </script>

</Layout>
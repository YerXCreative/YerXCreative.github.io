---
const navLinks = [
    { title: "Home", href: "/" },
    { title: "Work", href: "/works" },
    { title: "Resumé", href: "/about" }
]
---

<nav class="w-full bg-white py-4 px-12 flex items-center fixed top-0 left-0 z-50">
    <!-- Espacio vacío a la izquierda (mismo ancho que los botones) -->
    <div class="flex-1"></div>
    
    <!-- Logo perfectamente centrado -->
    <a href="/" class="text-[#2d1b4e] font-bold text-sm tracking-[0.3em] uppercase absolute left-1/2 -translate-x-1/2">
        YerxCreative
    </a>
    
    <!-- Botones a la derecha -->
    <ul class="flex gap-1 flex-1 justify-end">
        {navLinks.map((link, index) => (
            <li>
                <a 
                    href={link.href} 
                    class={`px-4 py-2 text-sm font-medium rounded-sm ${
                        index === 0 
                            ? 'bg-[#ccff00] text-[#2d1b4e]' 
                            : 'text-[#2d1b4e] hover:bg-gray-100'
                    }`}
                >
                    {link.title}
                </a>
            </li>
        ))}
    </ul>
</nav>
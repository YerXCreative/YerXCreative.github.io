---
const navLinks = [
    { title: "Home", href: "/" },
    { title: "Work", href: "/works" },
    { title: "Resumé", href: "/about" }
]
---

<nav class="w-full bg-white py-3 sm:py-4 px-3 sm:px-6 md:px-12 flex justify-center items-center fixed top-0 left-0 right-0 z-50">
    <div class="w-full max-w-7xl flex items-center justify-between sm:justify-center gap-3 sm:gap-8 md:gap-16 lg:gap-32">

        <!-- Logo -->
        <a
            href="/"
            class="shrink-0 text-[#2d1b4e] font-bold text-xs sm:text-sm tracking-[0.15em] sm:tracking-[0.2em] md:tracking-[0.3em] uppercase"
        >
            YerxCreative
        </a>

        <!-- Botones -->
        <ul class="flex items-center gap-0.5 sm:gap-1 shrink-0">
            {navLinks.map((link, index) => (
                <li>
                    <a
                        href={link.href}
                        class={`px-2 sm:px-3 md:px-4 py-2 text-xs sm:text-sm font-medium rounded-sm whitespace-nowrap ${
                            index === 0
                                ? 'bg-[#ccff00] text-[#2d1b4e]'
                                : 'text-[#2d1b4e] hover:bg-gray-100'
                        }`}
                    >
                        {link.title}
                    </a>
                </li>
            ))}
        </ul>

    </div>
</nav>
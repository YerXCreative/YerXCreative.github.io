---
import ImageContainer from "./ImageContainer.astro";

export interface Props {
    slug: string;
    featuredImage: string;
    title: string;
    client: string;
    category: string;
}

const { slug, featuredImage, title, client, category } = Astro.props;
---

<a
    href={`/works/${slug}`}
    class="group block"
>
    <!-- Imagen -->
    <div
        class="aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-[#292929]"
    >
        <ImageContainer
            src={featuredImage}
            alt={title}
            class="w-full h-full object-cover"
        />
    </div>

    <!-- Información -->
    <div class="mt-5">

        <div class="flex items-start justify-between gap-6">

            <div>
                <h2
                    class="text-2xl md:text-3xl font-bold tracking-[-0.03em] leading-tight text-white"
                >
                    {title}
                </h2>

                <p class="mt-2 text-neutral-500 text-sm">
                    {client}
                </p>
            </div>

            <span
                class="text-xs uppercase tracking-[0.15em] text-[#0066FF] shrink-0 pt-1"
            >
                {category}
            </span>

        </div>

        <!-- Línea editorial -->
        <div class="mt-5 border-b border-[#292929]"></div>

    </div>
</a>
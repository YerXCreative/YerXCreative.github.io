---
import Layout from "../layouts/Layout.astro";
import peter from "../assets/images/peter.jpg";
---

<style>
    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(40px);
        transition:
            opacity 800ms cubic-bezier(0.22, 1, 0.36, 1),
            transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: opacity, transform;
    }

    .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
        .reveal-on-scroll {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>

<Layout
    title="Yeray Díaz — Diseñador Digital"
    description="Portfolio de Yeray Díaz, diseñador digital y de proyectos."
>

    <!-- HERO -->

    <section class="relative bg-black text-white min-h-screen flex flex-col justify-between px-6 md:px-12 lg:px-20 pt-20 pb-8 overflow-hidden">

        <div class="max-w-[1400px] mx-auto w-full flex items-center justify-between text-[10px] md:text-xs uppercase tracking-[0.2em] text-neutral-500">

            <span>
                Diseñador digital & proyectos
            </span>

            <span class="hidden sm:block">
                Gijón · Asturias
            </span>

        </div>


        <div class="max-w-[1400px] mx-auto w-full flex-1 flex items-center py-10 md:py-12">

            <div class="w-full">

                <div class="flex items-center gap-4 mb-8">

                    <span class="w-2 h-2 rounded-full bg-[#0066FF]"></span>

                    <p class="text-[#0066FF] text-sm md:text-base font-bold uppercase tracking-[0.16em]">
                        Hola, soy Yeray
                    </p>

                </div>


                <h1 class="text-[clamp(4.5rem,12vw,11rem)] font-bold uppercase max-w-[1400px]">

                    Diseño con cabeza.
                    <br />

                    <span class="text-[#0066FF]">
                        Creatividad con actitud.
                    </span>

                </h1>

            </div>

        </div>


        <div class="max-w-[1400px] mx-auto w-full flex flex-col md:flex-row md:items-end md:justify-between gap-8">

            <p class="max-w-lg text-base md:text-lg text-neutral-400 leading-relaxed">
                Diseño, web, campañas y proyectos digitales
                con una mezcla bastante seria de creatividad,
                estrategia y criterio.
            </p>


            <a
                href="#about-preview"
                aria-label="Bajar a sobre mí"
                class="group flex items-center gap-4 self-start md:self-auto"
            >

                <span class="hidden md:block text-xs uppercase tracking-[0.2em] text-neutral-500">
                    Conóceme
                </span>

                <span class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-[#0066FF] text-white flex items-center justify-center group-hover:scale-110 transition-transform">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="w-6 h-6 md:w-7 md:h-7"
                        aria-hidden="true"
                    >
                        <path d="M12 5v14" />
                        <path d="m19 12-7 7-7-7" />
                    </svg>

                </span>

            </a>

        </div>

    </section>


    <!-- SOBRE MÍ -->

    <section
        id="about-preview"
        class="reveal-on-scroll bg-black text-white px-6 md:px-12 lg:px-20 py-16 md:py-24 lg:py-28"
    >

        <div class="max-w-[1400px] mx-auto">

            <div class="flex items-end justify-between mb-12 md:mb-16">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Sobre mí
                </p>

                <span class="hidden md:block text-xs uppercase tracking-[0.2em] text-neutral-600">
                    YerxCreative
                </span>

            </div>


            <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-14 lg:gap-24 items-end">

                <!-- TEXTO -->

                <div class="max-w-4xl">

                    <h2 class="text-5xl md:text-7xl lg:text-[7rem] font-bold mb-10">

                        <span class="text-[#0066FF]">
                            Diseño.
                        </span>
                        <br />

                        Proyectos.
                        <br />

                        Personas.

                    </h2>


                    <div class="max-w-2xl space-y-6 text-lg md:text-xl leading-relaxed text-neutral-400">

                        <p>
                            Soy Yeray Díaz, diseñador digital y de proyectos.
                        </p>

                        <p>
                            Trabajo en diseño web, campañas digitales,
                            identidad visual y gestión de proyectos,
                            llevando las ideas desde el briefing hasta la entrega.
                        </p>

                        <p>
                            Me interesa que las cosas funcionen,
                            pero también que tengan algo que decir.
                        </p>

                    </div>

                </div>


                <!-- FOTO -->

                <div class="relative max-w-[520px] lg:ml-auto">

                    <div class="absolute -right-4 -bottom-4 w-full h-full border-r-2 border-b-2 border-[#0066FF]"></div>

                    <div class="relative overflow-hidden">

                        <img
                            src={peter.src}
                            alt="Yeray Díaz, diseñador digital y de proyectos"
                            class="w-full h-auto object-cover"
                        />

                    </div>

                </div>

            </div>

        </div>

    </section>


   <!-- LO QUE HAGO -->

<section class="reveal-on-scroll bg-black text-white px-6 md:px-12 lg:px-20 py-20 md:py-28">

    <div class="max-w-[1400px] mx-auto">

        <div class="flex items-end justify-between mb-12 md:mb-16">

            <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                Lo que hago
            </p>

            <p class="hidden md:block max-w-xs text-sm text-neutral-600 text-right leading-relaxed">
                Ideas que necesitan forma,
                dirección y un poco de criterio.
            </p>

        </div>


        <div class="border-t border-[#292929]">

            <div class="group py-8 md:py-10 border-b border-[#292929] flex items-center justify-between gap-8">

                <h3 class="text-4xl md:text-6xl lg:text-7xl font-bold transition-colors duration-300 group-hover:text-[#0066FF]">
                    Identidad visual
                </h3>

                <span class="text-[#0066FF] text-2xl md:text-3xl shrink-0 transition-transform duration-300 group-hover:translate-x-2">
                    ↗
                </span>

            </div>


            <div class="group py-8 md:py-10 border-b border-[#292929] flex items-center justify-between gap-8">

                <h3 class="text-4xl md:text-6xl lg:text-7xl font-bold transition-colors duration-300 group-hover:text-[#0066FF]">
                    Diseño web
                </h3>

                <span class="text-[#0066FF] text-2xl md:text-3xl shrink-0 transition-transform duration-300 group-hover:translate-x-2">
                    ↗
                </span>

            </div>


            <div class="group py-8 md:py-10 border-b border-[#292929] flex items-center justify-between gap-8">

                <h3 class="text-4xl md:text-6xl lg:text-7xl font-bold transition-colors duration-300 group-hover:text-[#0066FF]">
                    Campañas digitales
                </h3>

                <span class="text-[#0066FF] text-2xl md:text-3xl shrink-0 transition-transform duration-300 group-hover:translate-x-2">
                    ↗
                </span>

            </div>


            <div class="group py-8 md:py-10 border-b border-[#292929] flex items-center justify-between gap-8">

                <h3 class="text-4xl md:text-6xl lg:text-7xl font-bold transition-colors duration-300 group-hover:text-[#0066FF]">
                    Gestión de proyectos
                </h3>

                <span class="text-[#0066FF] text-2xl md:text-3xl shrink-0 transition-transform duration-300 group-hover:translate-x-2">
                    ↗
                </span>

            </div>

        </div>

    </div>

</section>


   <!-- SELECTED WORK -->

<section
    id="selected-work"
    class="reveal-on-scroll bg-black text-white px-6 md:px-12 lg:px-20 py-20 md:py-28"
>

    <div class="max-w-[1400px] mx-auto">

        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">

            <div>

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Selected work
                </p>

                <h2 class="mt-5 text-5xl md:text-7xl lg:text-[7rem] font-bold">
                    Algunos trabajos.
                </h2>

            </div>


            <a
                href="/works"
                class="group inline-flex items-center gap-4 text-sm uppercase tracking-[0.15em] text-neutral-400 hover:text-white transition-colors"
            >

                <span>
                    Ver todos
                </span>

                <span class="w-10 h-10 rounded-full bg-[#0066FF] text-white flex items-center justify-center group-hover:translate-x-1 transition-transform">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="w-5 h-5"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>

                </span>

            </a>

        </div>


        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-16 md:gap-y-20">


            <!-- PROYECTO 1 -->

            <a href="/works" class="group block">

                <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A]">

                    <div class="absolute inset-0 flex items-end p-6 md:p-8">

                        <div>

                            <p class="mb-3 text-xs uppercase tracking-[0.18em] text-[#0066FF]">
                                Branding · 2024
                            </p>

                            <h3 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white">
                                Play to Die
                            </h3>

                        </div>

                    </div>

                </div>


                <div class="mt-5 flex items-start justify-between gap-6">

                    <p class="max-w-md text-sm md:text-base text-neutral-500 leading-relaxed">
                        Identidad visual y dirección gráfica para un proyecto con una estética
                        marcada y una personalidad propia.
                    </p>


                    <span class="text-[#0066FF] text-xl group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">
                        ↗
                    </span>

                </div>


                <div class="mt-5 h-px bg-[#292929] group-hover:bg-[#0066FF] transition-colors duration-300"></div>

            </a>


            <!-- PROYECTO 2 -->

            <a href="/works" class="group block md:mt-24">

                <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A]">

                    <div class="absolute inset-0 flex items-end p-6 md:p-8">

                        <div>

                            <p class="mb-3 text-xs uppercase tracking-[0.18em] text-[#0066FF]">
                                Branding · 2024
                            </p>

                            <h3 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white">
                                Maverick
                            </h3>

                        </div>

                    </div>

                </div>


                <div class="mt-5 flex items-start justify-between gap-6">

                    <p class="max-w-md text-sm md:text-base text-neutral-500 leading-relaxed">
                        Desarrollo de identidad visual y lenguaje gráfico para una marca
                        con una personalidad diferenciada.
                    </p>


                    <span class="text-[#0066FF] text-xl group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">
                        ↗
                    </span>

                </div>


                <div class="mt-5 h-px bg-[#292929] group-hover:bg-[#0066FF] transition-colors duration-300"></div>

            </a>


        </div>

    </div>

</section>


    <!-- CONTACTO -->

<section
    id="contact"
    class="reveal-on-scroll bg-black text-white px-6 md:px-12 lg:px-20 pt-24 md:pt-32 pb-16 md:pb-20"
>

    <div class="max-w-[1400px] mx-auto">

        <div class="border-t border-[#292929] pt-8 md:pt-10">

            <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                Contacto
            </p>

        </div>


        <div class="mt-16 md:mt-20">

            <h2 class="text-[clamp(4rem,10vw,9rem)] font-bold max-w-[1300px]">

                Hablemos
                <br />

                de tu próximo
                <br />

                <span class="text-[#0066FF]">
                    proyecto.
                </span>

            </h2>

        </div>


        <div class="mt-14 md:mt-20 flex flex-col md:flex-row md:items-end md:justify-between gap-10">

            <p class="max-w-xl text-lg md:text-xl leading-relaxed text-neutral-400">
                Si tienes una idea, un proyecto o simplemente quieres
                contarme qué tienes entre manos, escríbeme.
            </p>


            <a
                href="/contact"
                class="group inline-flex items-center gap-4 text-white text-base md:text-lg font-medium"
                aria-label="Cuéntame tu idea"
            >

                <span class="border-b border-white pb-1 group-hover:border-[#0066FF] transition-colors">
                    Cuéntame tu idea
                </span>


                <span class="w-12 h-12 rounded-full bg-[#0066FF] flex items-center justify-center group-hover:scale-110 transition-transform">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="w-5 h-5"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>

                </span>

            </a>

        </div>


        <div class="mt-20 md:mt-28 flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-t border-[#292929] pt-6">

            <p class="text-xs uppercase tracking-[0.18em] text-neutral-600">
                YerxCreative
            </p>

            <p class="text-xs uppercase tracking-[0.18em] text-neutral-600">
                Gijón · Asturias
            </p>

        </div>

    </div>

</section>

</Layout>
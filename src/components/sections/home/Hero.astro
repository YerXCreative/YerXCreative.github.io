---
// components
import Container from "../../elements/Container.astro"
import Text from "../../elements/Text.astro"
import Heading from "../../elements/Heading.astro"
import ImageContainer from "../../elements/ImageContainer.astro"
import Link from "../../elements/Link.astro"

// assets
// 👉 CAMBIA "peter.jpg" por el nombre de TU foto real (ej: "yeray.jpg")
import peter from "../../../assets/images/peter.jpg";
---

<Container variant={"xl"} class="flex flex-col gap-8 min-h-screen">
    <Text variant={'xl'} class="text-base-900 lg:max-w-1/3 md:max-w-1/2 w-full">
        ¡HOLA! Me especializo en crear diseños únicos y llamativos que ayudan a empresas como la tuya a destacarse en un mercado abarrotado.
    </Text>
    <Container class="flex md:flex-row flex-col gap-8">
        <Container class="md:flex-2 flex flex-col items-start gap-4">
            <Link variant={'button'} href="/contact">¡EMPECEMOS CON TU PROYECTO!</Link>
            <Heading tagName="h1" tagSize="h1">YERAY DÍAZ</Heading>
        </Container>
        <!-- 👉 AQUÍ CAMBIÉ 500px POR 600px Y EL ALT -->
        <Container class="h-full md:h-[600px] flex-1">
            <ImageContainer src={peter} alt="Yeray Díaz" />
        </Container>
    </Container>
</Container>
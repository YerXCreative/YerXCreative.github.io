---
import Layout from "../../layouts/Layout.astro";
import type { ImageMetadata } from "astro";

const imageModules = import.meta.glob(
    "../../content/images/ilustraciones/*.png",
    {
        eager: true,
        import: "default",
    }
);

const illustrations = Object.entries(imageModules)
    .sort(([pathA], [pathB]) => {
        const fileA = pathA.split("/").pop() ?? "";
        const fileB = pathB.split("/").pop() ?? "";

        const numberA = parseInt(fileA, 10);
        const numberB = parseInt(fileB, 10);

        return numberA - numberB;
    })
    .map(([path, image]) => ({
        image: image as ImageMetadata,
        title: `Ilustración ${String(
            parseInt(path.split("/").pop() ?? "0", 10)
        ).padStart(2, "0")}`,
    }));
---

<Layout
    title="Ilustraciones | YerxCreative"
    description="Una selección de ilustraciones de Yeray Díaz."
>

    <main class="bg-black text-white px-5 sm:px-6 md:px-12 lg:px-20 pt-20 sm:pt-24 md:pt-28 pb-14 md:pb-16">

        <div class="max-w-[1400px] mx-auto">

            <header class="mb-16 sm:mb-20 md:mb-24">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-500 mb-7">
                    YerxCreative / Ilustraciones
                </p>

                <div class="border-t border-[#292929] pt-8">

                    <h1
                        class="font-bold uppercase max-w-6xl text-[clamp(4rem,8vw,7.5rem)] leading-[0.82] tracking-[-0.02em]"
                    >
                        ILUSTRACIONES.
                    </h1>

                    <nav class="mt-8 md:mt-10 flex items-center gap-6">

                        <a
                            href="/works"
                            class="text-sm md:text-base font-semibold uppercase tracking-[0.08em] text-neutral-500 border-b-2 border-transparent pb-2 hover:text-white hover:border-[#0066FF] transition-colors"
                        >
                            Proyectos
                        </a>

                        <a
                            href="/works/ilustraciones"
                            class="text-sm md:text-base font-semibold uppercase tracking-[0.08em] text-white border-b-2 border-[#0066FF] pb-2"
                        >
                            Ilustraciones
                        </a>

                    </nav>

                    <p class="mt-8 md:mt-10 max-w-2xl text-base sm:text-lg md:text-xl text-neutral-400 leading-relaxed">
                        Una selección de ilustraciones personales y trabajos de Yeray Díaz.
                    </p>

                </div>

            </header>

            <section>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 md:gap-x-8 gap-y-12 md:gap-y-16">

                    {illustrations.map((illustration) => (

                        <article>

                            <div class="w-full overflow-hidden bg-[#0A0A0A]">

                                <img
                                    src={illustration.image.src}
                                    alt={illustration.title}
                                    class="block w-full h-auto"
                                    loading="lazy"
                                />

                            </div>

                            <h2
                                class="mt-4 text-xl md:text-2xl font-bold uppercase tracking-[-0.01em]"
                            >
                                {illustration.title}
                            </h2>

                        </article>

                    ))}

                </div>

            </section>

        </div>

    </main>

</Layout>
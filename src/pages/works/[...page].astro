---
import Layout from "../../layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import ImageContainer from "../../components/elements/ImageContainer.astro";

export const getStaticPaths = (async () => {
    const works = await getCollection("works", ({ data }) => !data.isDraft);

    return [
        {
            params: { page: undefined },
            props: { works },
        },
    ];
}) satisfies GetStaticPaths;

const { works } = Astro.props;

const projectOrder = [
    "recfck",
    "lynox",
    "move in",
    "play-to-die",
    "Moko",
    "maverick",
];

const displayTitles: Record<string, string> = {
    recfck: "RECFCK",
    lynox: "LYNOX",
    "move in": "MOVE IN",
    "play-to-die": "PLAY TO DIE",
    Moko: "MOKO",
    maverick: "MAVERICK",
};

const orderedWorks = [...works].sort((a, b) => {
    const slugA = a.data.slug.trim();
    const slugB = b.data.slug.trim();

    return projectOrder.indexOf(slugA) - projectOrder.indexOf(slugB);
});

const imageModules = import.meta.glob(
    "../../content/images/**/*.{jpg,jpeg,png,webp,avif}",
    {
        eager: true,
        import: "default",
    }
);

function getProjectImages(slug: string): ImageMetadata[] {
    return Object.entries(imageModules)
        .filter(([path]) => path.includes(`/images/${slug}/`))
        .sort(([pathA], [pathB]) => {
            const fileA = pathA.split("/").pop() ?? "";
            const fileB = pathB.split("/").pop() ?? "";

            const numberA = parseInt(fileA, 10);
            const numberB = parseInt(fileB, 10);

            if (!Number.isNaN(numberA) && !Number.isNaN(numberB)) {
                return numberA - numberB;
            }

            return fileA.localeCompare(fileB);
        })
        .map(([, image]) => image as ImageMetadata);
}
---

<Layout
    title="Proyectos | YerxCreative"
    description="Una selección de proyectos de YerxCreative."
>

    <main class="bg-black text-white px-5 sm:px-6 md:px-12 lg:px-20 pt-20 sm:pt-24 md:pt-28 pb-14 md:pb-16">

        <div class="max-w-[1400px] mx-auto">

            <header class="mb-16 sm:mb-20 md:mb-24">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-500 mb-7">
                    YerxCreative / Proyectos
                </p>

                <div class="border-t border-[#292929] pt-8">

                    <h1
                        class="font-bold uppercase max-w-6xl leading-[0.82] tracking-[-0.02em]"
                    >
                        <span class="block text-[clamp(4rem,8vw,7.5rem)]">
                            PROYECTOS.
                        </span>
                    </h1>

                    <p class="mt-7 md:mt-8 max-w-2xl text-base sm:text-lg md:text-xl text-neutral-400 leading-relaxed">
                        Una selección de proyectos de identidad visual, diseño digital,
                        campañas y dirección gráfica.
                    </p>

                    <nav class="mt-8 md:mt-10 flex items-center gap-6">

                        <a
                            href="/works"
                            class="text-sm md:text-base font-semibold uppercase tracking-[0.08em] text-white border-b-2 border-[#0066FF] pb-2"
                        >
                            Proyectos
                        </a>

                        <a
                            href="/works/ilustraciones"
                            class="text-sm md:text-base font-semibold uppercase tracking-[0.08em] text-neutral-500 border-b-2 border-transparent pb-2 hover:text-white hover:border-[#0066FF] transition-colors"
                        >
                            Ilustraciones
                        </a>

                        <a
                            href="/works/posters"
                            class="text-sm md:text-base font-semibold uppercase tracking-[0.08em] text-neutral-500 border-b-2 border-transparent pb-2 hover:text-white hover:border-[#0066FF] transition-colors"
                        >
                            Pósters
                        </a>

                    </nav>

                </div>

            </header>

            <div class="[&>article:last-child]:mb-0">

                {orderedWorks.map((work) => {

                    const {
                        title,
                        client,
                        category,
                        services,
                        year,
                        description,
                        slug,
                    } = work.data;

                    const projectImages = getProjectImages(slug);
                    const visibleImages = projectImages.slice(0, 4);

                    return (

                        <article
                            class="border-t border-[#292929] pt-8 sm:pt-10 md:pt-12 mb-20 sm:mb-24 md:mb-36"
                        >

                            <div class="grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr] gap-8 sm:gap-10 md:gap-16 mb-10 sm:mb-12 md:mb-14">

                                <div>

                                    <p class="text-[#0066FF] text-xs sm:text-sm uppercase tracking-[0.18em] font-semibold mb-4">
                                        {category}
                                    </p>

                                    <h2
                                        class="font-bold uppercase text-[clamp(3.5rem,7vw,7rem)] leading-[0.86] tracking-[-0.02em]"
                                    >
                                        {displayTitles[slug] ?? title.toUpperCase()}
                                    </h2>

                                    <div class="mt-5 sm:mt-6">

                                        <a
                                            href={`/works/${slug}`}
                                            class="group inline-flex items-center gap-3 text-[#0066FF] text-sm sm:text-base font-semibold"
                                        >

                                            <span class="border-b border-[#0066FF] pb-1">
                                                Ver proyecto completo
                                            </span>

                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                                                aria-hidden="true"
                                            >
                                                <path d="M5 12h14" />
                                                <path d="m13 6 6 6-6 6" />
                                            </svg>

                                        </a>

                                    </div>

                                </div>

                                <div class="md:pt-1">

                                    <div class="grid grid-cols-2 gap-x-5 gap-y-6 sm:gap-x-8 md:gap-x-10 mb-8">

                                        <div>
                                            <p class="text-[10px] sm:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-2">
                                                Cliente
                                            </p>
                                            <p class="text-sm sm:text-base text-white">
                                                {client}
                                            </p>
                                        </div>

                                        <div>
                                            <p class="text-[10px] sm:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-2">
                                                Año
                                            </p>
                                            <p class="text-sm sm:text-base text-white">
                                                {year}
                                            </p>
                                        </div>

                                        <div>
                                            <p class="text-[10px] sm:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-2">
                                                Servicios
                                            </p>
                                            <p class="text-sm sm:text-base text-white">
                                                {services}
                                            </p>
                                        </div>

                                    </div>

                                    <p class="max-w-2xl text-sm sm:text-base md:text-lg text-neutral-400 leading-relaxed">
                                        {description}
                                    </p>

                                </div>

                            </div>

                            {visibleImages.length > 0 && (

                                <div class="max-w-5xl mx-auto">

                                    {visibleImages.length === 1 && (
                                        <div class="max-w-[520px] mx-auto">
                                            <div class="overflow-hidden bg-[#0A0A0A] rounded-2xl">
                                                <ImageContainer
                                                    src={visibleImages[0]}
                                                    alt={`${title} — imagen 1`}
                                                    class="w-full h-auto"
                                                />
                                            </div>
                                        </div>
                                    )}

                                    {visibleImages.length === 2 && (
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-8">
                                            {visibleImages.map((image, index) => (
                                                <div class="overflow-hidden bg-[#0A0A0A] rounded-2xl">
                                                    <ImageContainer
                                                        src={image}
                                                        alt={`${title} — imagen ${index + 1}`}
                                                        class="w-full h-auto"
                                                    />
                                                </div>
                                            ))}
                                        </div>
                                    )}

                                    {visibleImages.length === 3 && (
                                        <div class="space-y-5 md:space-y-8">

                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-8">
                                                {visibleImages.slice(0, 2).map((image, index) => (
                                                    <div class="overflow-hidden bg-[#0A0A0A] rounded-2xl">
                                                        <ImageContainer
                                                            src={image}
                                                            alt={`${title} — imagen ${index + 1}`}
                                                            class="w-full h-auto"
                                                        />
                                                    </div>
                                                ))}
                                            </div>

                                            <div class="max-w-[50%] mx-auto">
                                                <div class="overflow-hidden bg-[#0A0A0A] rounded-2xl">
                                                    <ImageContainer
                                                        src={visibleImages[2]}
                                                        alt={`${title} — imagen 3`}
                                                        class="w-full h-auto"
                                                    />
                                                </div>
                                            </div>

                                        </div>
                                    )}

                                    {visibleImages.length >= 4 && (
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-8">
                                            {visibleImages.map((image, index) => (
                                                <div class="overflow-hidden bg-[#0A0A0A] rounded-2xl">
                                                    <ImageContainer
                                                        src={image}
                                                        alt={`${title} — imagen ${index + 1}`}
                                                        class="w-full h-auto"
                                                    />
                                                </div>
                                            ))}
                                        </div>
                                    )}

                                </div>
                            )}

                        </article>
                    );
                })}

            </div>

        </div>

    </main>

    <div
        id="image-lightbox"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 p-4 sm:p-6"
        aria-hidden="true"
    >

        <button
            id="lightbox-close"
            type="button"
            class="absolute top-5 right-5 sm:top-7 sm:right-7 w-10 h-10 rounded-full border border-white/20 text-white flex items-center justify-center hover:border-[#0066FF] hover:text-[#0066FF] transition-colors"
            aria-label="Cerrar imagen"
        >

            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="w-5 h-5"
                aria-hidden="true"
            >
                <path d="M6 6l12 12" />
                <path d="M18 6L6 18" />
            </svg>

        </button>

        <img
            id="lightbox-image"
            src=""
            alt=""
            class="max-w-full max-h-[90vh] object-contain"
        />

    </div>

    <script>
        const lightbox = document.getElementById("image-lightbox");
        const lightboxImage = document.getElementById("lightbox-image");
        const lightboxClose = document.getElementById("lightbox-close");

        const projectImages = document.querySelectorAll(
            "[data-lightbox-image]"
        );

        function closeLightbox() {
            if (!lightbox || !lightboxImage) return;

            lightbox.classList.add("hidden");
            lightbox.classList.remove("flex");
            lightbox.setAttribute("aria-hidden", "true");
            lightboxImage.setAttribute("src", "");
        }

        function openLightbox(src, alt) {
            if (!lightbox || !lightboxImage) return;

            lightboxImage.setAttribute("src", src);
            lightboxImage.setAttribute("alt", alt);

            lightbox.classList.remove("hidden");
            lightbox.classList.add("flex");
            lightbox.setAttribute("aria-hidden", "false");
        }

        projectImages.forEach((image) => {
            image.addEventListener("click", () => {
                const src = image.getAttribute("data-lightbox-image");
                const alt = image.getAttribute("alt") ?? "";

                if (src) {
                    openLightbox(src, alt);
                }
            });
        });

        lightboxClose?.addEventListener("click", closeLightbox);

        lightbox?.addEventListener("click", (event) => {
            if (event.target === lightbox) {
                closeLightbox();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                closeLightbox();
            }
        });
    </script>

</Layout>
<section class="bg-black text-white px-6 md:px-12 lg:px-20 pb-16">

    <div class="max-w-[1400px] mx-auto">

        <div class="border-t border-[#0066FF] pt-10">

            <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-10 md:gap-16 items-end">

                <!-- INFORMACIÓN PRINCIPAL -->
                <div>

                    <p class="text-xs uppercase tracking-[0.2em] text-neutral-500 mb-5">
                        Hablemos
                    </p>

                    <a
                        href="mailto:yeraydxz@gmail.com"
                        class="block text-3xl md:text-5xl lg:text-6xl font-bold tracking-[-0.05em] leading-none text-white hover:text-[#0066FF] transition-colors duration-200"
                    >
                        yeraydxz@gmail.com
                    </a>

                    <p class="mt-5 text-neutral-500 text-base">
                        También puedes escribirme directamente por WhatsApp.
                    </p>

                </div>


                <!-- ACCIONES -->
                <div class="flex flex-wrap md:justify-end gap-3">

                    <!-- WHATSAPP -->
                    <a
                        href="https://wa.me/34697601146?text=Hola%20Yeray%2C%20me%20gustar%C3%ADa%20hablar%20contigo%20sobre%20un%20proyecto.%20%C2%BFPodemos%20comentar%20los%20detalles%3F"

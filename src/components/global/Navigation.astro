---
const navLinks = [
    { title: "Home", href: "/" },
    { title: "Work", href: "/works" },
    { title: "Resumé", href: "/about" }
]
---

<nav class="w-full py-6 px-12 flex justify-center bg-[#2d1b4e]">
    <ul class="flex gap-8 text-sm font-medium">
        {navLinks.map((link, index) => (
            <li>
                <a 
                    href={link.href} 
                    class={`px-4 py-2 rounded ${index === 0 ? 'bg-[#ccff00] text-[#2d1b4e]' : 'text-white hover:text-[#ccff00]'}`}
                >
                    {link.title}
                </a>
            </li>
        ))}
    </ul>
</nav>
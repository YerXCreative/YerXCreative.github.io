---
import Layout from '../layouts/Layout.astro';
import peter from "../assets/images/peter.jpg";
---

<Layout title="Yeray Díaz" description="Diseñador Gráfico y Web">

    <!-- TÍTULO / HERO -->
    <div class="relative left-1/2 -translate-x-1/2 w-screen -mt-16 bg-[#5b3a8c] py-14 md:py-16">
        <h1 class="text-5xl md:text-7xl font-bold text-center text-[#ccff00]">
            ¡Hola! Soy Yeray
        </h1>
    </div>


    <!-- CONTENIDO PRINCIPAL -->
    <main class="relative left-1/2 -translate-x-1/2 w-screen bg-[#2d1b4e]">

        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2">

            <!-- TEXTO -->
            <div class="flex flex-col gap-16 py-16 px-6 md:px-12 lg:px-20">

                <div>
                    <p class="text-white text-lg md:text-xl leading-relaxed mb-6">
                        Soy Yeray Díaz, un Diseñador Gráfico y Web especializado en identidades visuales.
                    </p>

                    <p class="text-white text-lg md:text-xl leading-relaxed">
                        He colaborado con grandes empresas y startups en campañas integrales.
                    </p>
                </div>


                <div>
                    <h2 class="text-4xl md:text-5xl font-bold text-[#ccff00] mb-6">
                        No soy un robot.
                    </h2>

                    <p class="text-white text-lg md:text-xl leading-relaxed">
                        Aporto un toque humano combinando creatividad con IA.
                    </p>
                </div>


                <div>
                    <h2 class="text-4xl md:text-5xl font-bold text-[#ccff00] mb-6">
                        Otros datos sobre mí.
                    </h2>

                    <ul class="text-white text-lg md:text-xl leading-relaxed space-y-3">
                        <li>• Amante del diseño minimalista</li>
                        <li>• Adicto a la cafeína</li>
                        <li>• Entusiasta de la tecnología</li>
                        <li>• Creo en el buen diseño</li>
                    </ul>
                </div>

            </div>


            <!-- FOTO -->
            <div class="hidden md:flex items-center justify-center px-8 py-16">

                <div class="w-full max-w-[500px] border border-[#ccff00] p-3">

                    <img
                        src={peter.src}
                        alt="Yeray Díaz, diseñador gráfico y web"
                        class="w-full h-auto object-contain"
                    />

                </div>

            </div>

        </div>

    </main>


    <!-- FOOTER -->
   <footer class="relative left-1/2 -translate-x-1/2 w-screen min-h-[180px] py-8 px-6 bg-[#7c3aed]">

        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-6 text-center">


            <!-- WHATSAPP -->
            <div class="flex flex-col items-center">

                <h3 class="text-lg font-bold text-[#00ffff] mb-3">
                    WhatsApp
                </h3>

                <a
                    href="https://wa.me/34697601146?text=Hola%20Yeray%2C%20me%20gustar%C3%ADa%20hablar%20contigo%20sobre%20un%20proyecto.%20%C2%BFPodemos%20comentar%20los%20detalles%3F"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Contactar con Yeray por WhatsApp"
                    class="text-white hover:text-[#ccff00] transition-colors"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="w-8 h-8"
                    >
                        <path d="M20.52 3.48A11.86 11.86 0 0 0 12.07 0C5.51 0 .17 5.34.17 11.9c0 2.1.55 4.15 1.6 5.96L.1 24l6.28-1.64a11.88 11.88 0 0 0 5.69 1.45h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.16-3.46-8.43ZM12.08 21.8h-.01a9.88 9.88 0 0 1-5.04-1.38l-.36-.21-3.73.98.99-3.64-.23-.37a9.88 9.88 0 1 1 8.38 4.62Zm5.42-7.4c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.69.15-.2.3-.79.98-.97 1.18-.18.2-.36.22-.66.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.64-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.36.45-.54.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.69-1.66-.94-2.28-.25-.6-.5-.52-.69-.53h-.59c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.1 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.07-.12-.27-.2-.57-.35Z"/>
                    </svg>

                </a>

            </div>


            <!-- EMAIL -->
            <div class="flex flex-col items-center">

                <h3 class="text-lg font-bold text-[#00ffff] mb-3">
                    Empecemos tu proyecto
                </h3>

                <a
                    href="https://mail.google.com/mail/?view=cm&fs=1&to=yeraydxz@gmail.com&su=Empecemos%20tu%20proyecto&body=Hola%20Yeray%2C%0A%0AMe%20gustar%C3%ADa%20hablar%20contigo%20sobre%20un%20proyecto."
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Enviar email a Yeray"
                    class="text-white hover:text-[#ccff00] transition-colors"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-8 h-8"
                    >
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="M3 7l9 6 9-6" />
                    </svg>

                </a>

            </div>


            <!-- REDES SOCIALES -->
            <div class="flex flex-col items-center">

                <h3 class="text-lg font-bold text-[#00ffff] mb-3">
                    Connect
                </h3>

                <div class="flex items-center justify-center gap-5">

                    <!-- Instagram -->
                    <a
                        href="https://instagram.com/yerxcreative"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram de Yeray"
                        class="text-white hover:text-[#ccff00] transition-colors"
                    >

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-8 h-8"
                        >
                            <rect
                                x="3"
                                y="3"
                                width="18"
                                height="18"
                                rx="5"
                            />

                            <circle
                                cx="12"
                                cy="12"
                                r="4"
                            />

                            <circle
                                cx="17.5"
                                cy="6.5"
                                r="1"
                                fill="currentColor"
                                stroke="none"
                            />
                        </svg>

                    </a>


                    <!-- Threads -->
                    <a
                        href="https://threads.com/@yerxcreative"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Threads de Yeray"
                        class="text-white hover:text-[#ccff00] transition-colors"
                    >

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="w-8 h-8"
                        >
                            <path d="M16.9 11.1c-.16-2.7-1.73-4.3-4.44-4.5-1.5-.1-2.76.28-3.67 1.1-.72.65-1.13 1.5-1.2 2.5h2.05c.1-.55.34-.96.72-1.27.45-.37 1.1-.53 1.94-.47 1.48.1 2.3.84 2.48 2.2-.82-.22-1.68-.33-2.55-.33-3.14 0-5.17 1.57-5.17 4 0 2.2 1.72 3.7 4.28 3.7 2.3 0 3.93-1.08 4.68-3.02.54.26.91.63 1.1 1.1.22.56.3 1.22.2 1.95-.28 2.57-2.55 4.04-5.48 4.04-4.2 0-7.2-2.82-7.2-7.16 0-4.6 3.2-7.62 7.75-7.62 4.17 0 6.77 2.42 7.04 6.4h-2.53Zm-5.49 5.06c-1.4 0-2.31-.58-2.31-1.55 0-1.15 1.08-1.9 2.86-1.9.82 0 1.65.1 2.42.3-.1 2.04-1.07 3.15-2.97 3.15Z"/>
                        </svg>

                    </a>

                </div>

            </div>

        </div>

    </footer>

</Layout>
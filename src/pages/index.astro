---
import Layout from '../layouts/Layout.astro';
import peter from "../assets/images/peter.jpg";
---

<Layout title="Yeray Díaz" description="Diseñador Gráfico y Web">

    <!-- FRANJA MORADA CON TÍTULO -->
    <div class="w-full bg-[#5b3a8c] py-16 -mt-16" style="width: 100vw; margin-left: -50vw; left: 50%; position: relative;">
        <h1 class="text-5xl md:text-7xl font-bold text-center text-[#ccff00]">
            ¡Hola! Soy Yeray
        </h1>
    </div>

    <!-- CONTENIDO PRINCIPAL: Texto izquierda + Foto derecha (full width) -->
    <div class="w-full bg-[#2d1b4e]">
        <div class="grid md:grid-cols-[1fr_1fr]">
            
            <!-- COLUMNA IZQUIERDA: Textos apilados (con padding) -->
            <div class="flex flex-col gap-16 py-16 px-6 md:px-24 lg:px-32">
                
                <!-- Bio -->
                <div>
                    <p class="text-white text-lg mb-6">
                        Soy Yeray Díaz, un Diseñador Gráfico y Web especializado en identidades visuales.
                    </p>
                    <p class="text-white text-lg">
                        He colaborado con grandes empresas y startups en campañas integrales.
                    </p>
                </div>

                <!-- No soy un robot -->
                <div>
                    <h2 class="text-4xl font-bold text-[#ccff00] mb-6">No soy un robot.</h2>
                    <p class="text-white text-lg">
                        Aporto un toque humano combinando creatividad con IA.
                    </p>
                </div>

                <!-- Otros datos -->
                <div>
                    <h2 class="text-4xl font-bold text-[#ccff00] mb-6">Otros datos sobre mí.</h2>
                    <ul class="text-white text-lg space-y-2">
                        <li>• Amante del diseño minimalista</li>
                        <li>• Adicto a la cafeína</li>
                        <li>• Entusiasta de la tecnología</li>
                        <li>• Creo en el buen diseño</li>
                    </ul>
                </div>
            </div>

            <!-- COLUMNA DERECHA: Foto gigante (sin padding, hasta el borde) -->
            <div class="hidden md:block">
                <img 
                    src={peter.src} 
                    alt="Yeray" 
                    class="w-full h-full object-cover"
                    style="min-height: 100%;"
                />
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="w-full py-16 px-6 bg-[#7c3aed]">
        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-12 text-center">
            <div>
                <h3 class="text-xl font-bold text-[#00ffff] mb-2">Phone</h3>
                <p class="text-white text-sm">+34 600 000 000</p>
            </div>
            <div>
                <h3 class="text-xl font-bold text-[#00ffff] mb-2">Email</h3>
                <p class="text-white text-sm">yerxcreativestudio@gmail.com</p>
            </div>
            <div>
                <h3 class="text-xl font-bold text-[#00ffff] mb-2">Connect</h3>
                <div class="flex justify-center gap-4 text-white text-sm">
                    <a href="https://instagram.com/yerxcreative">Instagram</a>
                    <a href="https://threads.com/@yerxcreative">Threads</a>
                </div>
            </div>
        </div>
    </footer>

</Layout>
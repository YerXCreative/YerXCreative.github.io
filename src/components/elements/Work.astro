---
import ImageContainer from "./ImageContainer.astro";

export interface Props {
    slug: string;
    featuredImage: string;
    title: string;
    client: string;
    category: string;
}

const { slug, featuredImage, title, client, category } = Astro.props;
---

<a
    href={`/works/${slug}`}
    class="group block"
>

    <!-- IMAGEN -->

    <div class="aspect-[4/3] overflow-hidden bg-[#0A0A0A]">

        <ImageContainer
            src={featuredImage}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        />

    </div>


    <!-- INFORMACIÓN -->

    <div class="mt-6">

        <div class="flex items-start justify-between gap-8">

            <div class="min-w-0">

                <h2 class="text-4xl md:text-5xl font-bold text-white">
                    {title}
                </h2>

                <p class="mt-3 text-neutral-500 text-sm md:text-base">
                    {client}
                </p>

            </div>


            <div class="flex items-center gap-3 shrink-0 pt-2">

                <span class="hidden sm:block text-xs uppercase tracking-[0.15em] text-[#0066FF]">
                    {category}
                </span>

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    class="w-5 h-5 text-[#0066FF] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-200"
                    aria-hidden="true"
                >
                    <path d="M7 17 17 7" />
                    <path d="M7 7h10v10" />
                </svg>

            </div>

        </div>


        <!-- LÍNEA EDITORIAL -->

        <div class="mt-6 h-px bg-[#292929] group-hover:bg-[#0066FF] transition-colors duration-300"></div>

    </div>

</a>
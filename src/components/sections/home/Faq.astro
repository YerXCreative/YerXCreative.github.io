---
// components
import Container from "../../elements/Container.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";
import Heading from "../../elements/Heading.astro";
import Dropdown from "../../elements/Dropdown.astro";

// content
const faq = [
    { 
        title: "¿Cuál es el plazo habitual de tus proyectos?",
        text: "Los plazos varían según el alcance y la complejidad. Una identidad de marca sencilla puede tomar de 3 a 4 semanas, mientras que un proyecto integral de diseño web o aplicación suele oscilar entre 6 y 12 semanas."
    },
    { 
        title: "¿Cómo estructuras tus precios?",
        text: "Ofrezco tarifas por proyecto o por horas según el alcance del trabajo. La mayoría de los clientes prefieren tarifas fijas por proyecto para un presupuesto predecible. Requiero un depósito del 50% para comenzar, y el resto se paga al finalizar."
    },
    { 
        title: "¿Qué incluye tu proceso de diseño?",
        text: "Mi proceso incluye típicamente el descubrimiento y la estrategia, la investigación y el desarrollo de conceptos, la exploración del diseño, revisiones basadas en tus comentarios y la entrega final de todos los recursos."
    },
    { 
        title: "¿Trabajas con clientes de forma remota?",
        text: "¡Absolutamente! Trabajo con clientes de todo el mundo y he desarrollado procesos de colaboración remota muy eficientes. Utilizaremos videollamadas para reuniones clave y plataformas de diseño colaborativo para el intercambio de opiniones."
    },
    { 
        title: "¿Cuántas revisiones están incluidas?",
        text: "La mayoría de los proyectos incluyen de 2 a 3 rondas de revisiones para garantizar el resultado perfecto. Recomiendo unificar los comentarios para aprovechar al máximo cada ronda de revisión."
    },
]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Preguntas Frecuentes</Heading>
    <div class="flex flex-col gap-4">
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                faq.map((q, index) => (
                    <Dropdown title=`${index + 1}. ${q.title}`  text={q.text} />
                ))
            }
        </Container>
        <ContainerBottom />        
    </div>
    
</Container>
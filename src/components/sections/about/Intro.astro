---
import peter3 from "../../../assets/images/peter3.jpg";
---

<section class="bg-black text-white">

    <!-- CABECERA -->

    <div class="px-6 md:px-12 lg:px-20 pt-20 md:pt-24">

        <div class="max-w-[1400px] mx-auto">

            <header>

                <p class="uppercase tracking-[0.2em] text-sm text-neutral-500 mb-7">
                    YerxCreative / Sobre mí
                </p>

                <div class="pt-2">

                    <h1 class="font-bold uppercase max-w-6xl leading-[0.9] tracking-[-0.02em]">

                        <span class="block text-[clamp(5rem,10vw,9rem)]">
                            SOBRE
                        </span>

                        <span class="block text-[clamp(5rem,10vw,9rem)] text-[#0066FF] mt-5 md:mt-7">
                            MÍ
                        </span>

                    </h1>

                </div>

            </header>

        </div>

    </div>


    <!-- PRESENTACIÓN -->

    <section class="px-6 md:px-12 lg:px-20 pt-16 md:pt-20 pb-20 md:pb-24">

        <div class="max-w-[1400px] mx-auto grid grid-cols-2 gap-16 lg:gap-24 items-start">

            <!-- TEXTO -->

            <div class="flex flex-col gap-7 md:gap-8">

                <p class="text-3xl md:text-5xl font-bold leading-[1.02] tracking-[-0.01em] text-white max-w-3xl">
                    Diseño, proyectos y creatividad.
                </p>

                <p class="text-lg md:text-xl leading-relaxed text-neutral-400 max-w-2xl">
                    Soy Yeray Díaz Cortina, diseñador digital y de proyectos.
                    Trabajo en diseño web, campañas digitales, identidad visual
                    y gestión de proyectos.
                </p>

                <p class="text-lg md:text-xl leading-relaxed text-neutral-400 max-w-2xl">
                    Me interesa crear soluciones que funcionen, que tengan
                    personalidad y que sean capaces de convertir una idea
                    en algo que la gente pueda entender y recordar.
                </p>

            </div>


            <!-- IMAGEN -->

            <div class="flex justify-end">

                <div class="relative w-full max-w-[520px]">

                    <div class="absolute right-[-10px] bottom-[-10px] w-full h-full border-r-2 border-b-2 border-[#0066FF] rounded-[28px]">
                    </div>

                    <div class="relative overflow-hidden rounded-[28px]">

                        <img
                            src={peter3.src}
                            alt="Yeray Díaz Cortina, diseñador digital y de proyectos"
                            class="w-full h-auto object-cover"
                        />

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- LO QUE HAGO -->

    <section class="px-6 md:px-12 lg:px-20 pt-8 md:pt-12 pb-16 md:pb-20">

        <div class="max-w-[1400px] mx-auto">

            <div class="grid grid-cols-[0.45fr_1.55fr] gap-10 md:gap-12">

                <div>

                    <p class="uppercase tracking-[0.2em] text-sm text-neutral-500">
                        Lo que hago
                    </p>

                </div>


                <div>

                    <div>

                        <div class="py-6 md:py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Identidad visual
                            </h2>
                        </div>

                        <div class="py-6 md:py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Diseño web
                            </h2>
                        </div>

                        <div class="py-6 md:py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Campañas digitales
                            </h2>
                        </div>

                        <div class="py-6 md:py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Diseño gráfico
                            </h2>
                        </div>

                        <div class="py-6 md:py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Gestión de proyectos
                            </h2>
                        </div>

                        <div class="py-6 md:py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Cliente y comunicación
                            </h2>
                        </div>

                        <div class="py-6 md:py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Herramientas creativas
                            </h2>
                        </div>

                        <div class="py-6 md:py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                IA aplicada al diseño
                            </h2>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CIERRE -->

    <section class="px-6 md:px-12 lg:px-20 pt-4 md:pt-6 pb-8 md:pb-10">

        <div class="max-w-[1400px] mx-auto">

            <div>

                <p class="text-4xl md:text-6xl lg:text-7xl font-bold leading-[0.95] tracking-[-0.015em] max-w-5xl">
                    Diseño con intención.
                </p>

                <p class="text-4xl md:text-6xl lg:text-7xl font-bold leading-[0.95] tracking-[-0.015em] max-w-5xl text-[#0066FF]">
                    Creatividad con criterio.
                </p>

            </div>

        </div>

    </section>

</section>
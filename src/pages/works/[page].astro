---
import Layout from "../../layouts/Layout.astro";
import "../../styles/markdown.css";

import type { GetStaticPaths } from "astro";
import type { ImageMetadata } from "astro";
import { render, getCollection } from "astro:content";

import ImageContainer from "../../components/elements/ImageContainer.astro";

export const getStaticPaths = (async () => {
    const works = await getCollection("works", ({ data }) => !data.isDraft);

    return works.map((work) => ({
        params: { page: work.data.slug },
        props: { work },
    }));
}) satisfies GetStaticPaths;

const { work } = Astro.props;
const { Content } = await render(work);

const {
    title,
    client,
    category,
    services,
    year,
    description,
} = work.data;

const imageModules = import.meta.glob(
    "../../content/images/**/*.{jpg,jpeg,png,webp,avif}",
    {
        eager: true,
        import: "default",
    }
);

const projectImages = Object.entries(imageModules)
    .filter(([path]) => path.includes(`/images/${work.data.slug}/`))
    .sort(([pathA], [pathB]) => {
        const fileA = pathA.split("/").pop() ?? "";
        const fileB = pathB.split("/").pop() ?? "";

        const numberA = parseInt(fileA, 10);
        const numberB = parseInt(fileB, 10);

        if (!Number.isNaN(numberA) && !Number.isNaN(numberB)) {
            return numberA - numberB;
        }

        return fileA.localeCompare(fileB);
    })
    .map(([, image]) => image as ImageMetadata);
---

<Layout
    title={`${title} | YerxCreative`}
    description={description}
>
    <main class="bg-black text-white px-5 sm:px-6 md:px-12 lg:px-20 pt-20 sm:pt-24 md:pt-28 pb-14 md:pb-16">

        <div class="max-w-[1400px] mx-auto">

            <!-- CABECERA -->

            <header class="mb-12 sm:mb-14 md:mb-16">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-500 mb-6">
                    YerxCreative / Proyectos
                </p>

                <div class="border-t border-[#292929] pt-7">

                    <p class="text-[#0066FF] text-xs md:text-sm uppercase tracking-[0.18em] font-semibold mb-4">
                        {category}
                    </p>

                    <h1
                        class="font-bold uppercase max-w-6xl text-[clamp(4rem,8vw,9rem)] leading-[0.82] tracking-[-0.02em]"
                    >
                        {title}
                    </h1>

                </div>

            </header>


            <!-- INFORMACIÓN DEL PROYECTO -->

            <section class="border-y border-[#292929] py-7 md:py-8 mb-12 md:mb-14">

                <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-6 md:gap-10">

                    <div>
                        <p class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-1.5">
                            Cliente
                        </p>

                        <p class="text-sm md:text-base text-white">
                            {client}
                        </p>
                    </div>

                    <div>
                        <p class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-1.5">
                            Categoría
                        </p>

                        <p class="text-sm md:text-base text-white">
                            {category}
                        </p>
                    </div>

                    <div>
                        <p class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-1.5">
                            Servicios
                        </p>

                        <p class="text-sm md:text-base text-white">
                            {services}
                        </p>
                    </div>

                    <div>
                        <p class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-neutral-500 mb-1.5">
                            Año
                        </p>

                        <p class="text-sm md:text-base text-white">
                            {year}
                        </p>
                    </div>

                </div>

            </section>


            <!-- PROYECTO + IMÁGENES -->

            <section class="grid grid-cols-1 lg:grid-cols-[1.6fr_0.9fr] gap-10 lg:gap-16 mb-12 md:mb-16">

                <!-- IMÁGENES -->

                {projectImages.length > 0 && (

                    <div class="grid grid-cols-2 gap-4 md:gap-5">

                        {projectImages.map((image, index) => (

                            <div class="w-full overflow-hidden bg-[#0A0A0A] rounded-xl">

                                <ImageContainer
                                    src={image}
                                    alt={`${title} — imagen ${index + 1}`}
                                    class="w-full h-auto"
                                />

                            </div>

                        ))}

                    </div>

                )}


                <!-- EL PROYECTO -->

                <div class="lg:pt-1">

                    <p class="text-xs uppercase tracking-[0.18em] text-neutral-500 mb-5">
                        El proyecto
                    </p>

                    <p class="font-bold text-[clamp(1.8rem,3vw,3.5rem)] leading-[0.98] tracking-[-0.02em] text-white">
                        {description}
                    </p>

                </div>

            </section>


            <!-- CONTENIDO DEL PROYECTO -->

            <article class="markdown-content max-w-4xl mx-auto py-2 md:py-6">

                <Content />

            </article>


            <!-- VOLVER -->

            <section class="mt-12 md:mt-16 border-t border-[#292929] pt-7">

                <a
                    href="/works"
                    class="group inline-flex items-center gap-3 text-white font-semibold"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-5 h-5 group-hover:-translate-x-1 transition-transform"
                        aria-hidden="true"
                    >
                        <path d="M19 12H5" />
                        <path d="m11 18-6-6 6-6" />
                    </svg>

                    <span class="border-b border-white pb-1 group-hover:border-[#0066FF] transition-colors">
                        Todos los proyectos
                    </span>

                </a>

            </section>

        </div>

    </main>
</Layout>
---
import Layout from '../layouts/Layout.astro';
import peter from "../assets/images/peter.jpg";
---

<Layout title="Yeray Díaz" description="Diseñador Gráfico y Web">

    <!-- TÍTULO / HERO -->
    <div class="relative left-1/2 -translate-x-1/2 w-screen -mt-16 bg-[#5b3a8c] py-14 md:py-16">
        <h1 class="text-5xl md:text-7xl font-bold text-center text-[#ccff00]">
            ¡Hola! Soy Yeray
        </h1>
    </div>


    <!-- CONTENIDO PRINCIPAL -->
    <main class="relative left-1/2 -translate-x-1/2 w-screen bg-[#2d1b4e]">

        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2">

            <!-- TEXTO -->
            <div class="flex flex-col gap-16 py-16 px-6 md:px-12 lg:px-20">

                <div>
                    <p class="text-white text-lg md:text-xl leading-relaxed mb-6">
                        Soy Yeray Díaz, un Diseñador Gráfico y Web especializado en identidades visuales.
                    </p>

                    <p class="text-white text-lg md:text-xl leading-relaxed">
                        He colaborado con grandes empresas y startups en campañas integrales.
                    </p>
                </div>


                <div>
                    <h2 class="text-4xl md:text-5xl font-bold text-[#ccff00] mb-6">
                        No soy un robot.
                    </h2>

                    <p class="text-white text-lg md:text-xl leading-relaxed">
                        Aporto un toque humano combinando creatividad con IA.
                    </p>
                </div>


                <div>
                    <h2 class="text-4xl md:text-5xl font-bold text-[#ccff00] mb-6">
                        Otros datos sobre mí.
                    </h2>

                    <ul class="text-white text-lg md:text-xl leading-relaxed space-y-3">
                        <li>• Amante del diseño minimalista</li>
                        <li>• Adicto a la cafeína</li>
                        <li>• Entusiasta de la tecnología</li>
                        <li>• Creo en el buen diseño</li>
                    </ul>
                </div>

            </div>


            <!-- FOTO -->
            <div class="hidden md:flex items-center justify-center px-8 py-16">

                <div class="w-full max-w-[500px] border border-[#ccff00] p-3">

                    <img
                        src={peter.src}
                        alt="Yeray Díaz, diseñador gráfico y web"
                        class="w-full h-auto object-contain"
                    />

                </div>

            </div>

        </div>

    </main>


    <!-- FOOTER -->
    <footer class="relative left-1/2 -translate-x-1/2 w-screen py-16 px-6 bg-[#7c3aed]">

        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-12 text-center">

            <div>
                <h3 class="text-xl font-bold text-[#00ffff] mb-2">
                    Phone
                </h3>

                <p class="text-white text-sm">
                    +34 600 000 000
                </p>
            </div>


            <div>
                <h3 class="text-xl font-bold text-[#00ffff] mb-2">
                    Email
                </h3>

                <p class="text-white text-sm">
                    yerxcreativestudio@gmail.com
                </p>
            </div>


            <div>
                <h3 class="text-xl font-bold text-[#00ffff] mb-2">
                    Connect
                </h3>

                <div class="flex justify-center gap-4 text-white text-sm">

                    <a
                        href="https://instagram.com/yerxcreative"
                        class="hover:opacity-70 transition-opacity"
                    >
                        Instagram
                    </a>

                    <a
                        href="https://threads.com/@yerxcreative"
                        class="hover:opacity-70 transition-opacity"
                    >
                        Threads
                    </a>

                </div>
            </div>

        </div>

    </footer>

</Layout>
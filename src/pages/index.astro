---
import Layout from "../layouts/Layout.astro";
import peter from "../assets/images/peter.jpg";
import recfckImage from "../content/images/recfck/1.png";
import lynoxImage from "../content/images/lynox/1.jpg";
---

<Layout
    title="Yeray Díaz — Diseñador gráfico y digital"
    description="Portfolio de Yeray Díaz, diseñador gráfico y digital."
>

    <!-- PRESENTACIÓN -->
    <section class="relative bg-black text-white px-5 sm:px-6 md:px-12 lg:px-20 pt-12 sm:pt-14 md:pt-20 pb-10 sm:pb-12 md:pb-14 overflow-hidden">

        <div class="max-w-[1400px] mx-auto w-full">

            <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-20 items-start">

                <div class="max-w-5xl">

                    <div class="flex items-center gap-3 md:gap-4 mb-5">

                        <span class="w-2 h-2 rounded-full bg-[#0066FF] shrink-0"></span>

                        <p class="text-[#0066FF] text-xs sm:text-sm md:text-base font-bold uppercase tracking-[0.16em]">
                            Hola, soy Yeray
                        </p>

                    </div>

                    <h1 class="text-[clamp(4rem,18vw,9rem)] sm:text-[clamp(4.5rem,14vw,9rem)] md:text-[clamp(5rem,10vw,9rem)] font-bold uppercase leading-[1.05] md:leading-[1.15] max-w-[1000px]">

                        <span class="block">
                            PIENSO.
                        </span>

                        <span class="block text-[#0066FF] mt-3 md:mt-4">
                            DISEÑO.
                        </span>

                        <span class="block mt-3 md:mt-4">
                            CREO.
                        </span>

                    </h1>

                    <div class="mt-7 sm:mt-8 md:mt-10 max-w-2xl space-y-4 md:space-y-5 text-base sm:text-lg md:text-xl leading-relaxed text-neutral-400">

                        <p>
                            Soy Yeray Díaz, diseñador digital y de proyectos.
                        </p>

                        <p>
                            Trabajo en diseño web, campañas digitales, identidad visual y gestión de proyectos, llevando las ideas desde el briefing hasta la entrega.
                        </p>

                        <p>
                            Me interesa que las cosas funcionen, pero también que tengan algo que decir.
                        </p>

                    </div>

                </div>

                <!-- FOTO -->

                <div class="relative w-full max-w-[460px] lg:ml-auto mt-4 lg:mt-0">

                    <div class="absolute -right-3 sm:-right-4 -bottom-3 sm:-bottom-4 w-full h-full border-r-2 border-b-2 border-[#0066FF] rounded-br-2xl pointer-events-none"></div>

                    <div class="relative overflow-hidden rounded-2xl">

                        <img
                            src={peter.src}
                            alt="Yeray Díaz, diseñador digital y de proyectos"
                            class="w-full h-auto object-cover"
                        />

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- LO QUE HAGO -->

    <section class="bg-black text-white px-5 sm:px-6 md:px-12 lg:px-20 pt-5 sm:pt-6 md:pt-10 pb-8 md:pb-10">

        <div class="max-w-[1400px] mx-auto">

            <div class="flex items-end justify-between mb-7 md:mb-10">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Lo que hago
                </p>

                <p class="hidden md:block max-w-xs text-sm text-neutral-600 text-right leading-relaxed">
                    Ideas que necesitan forma, dirección y un poco de criterio.
                </p>

            </div>

            <div class="border-t border-[#292929]">

                <div class="group py-5 sm:py-6 md:py-7 border-b border-[#292929] flex items-center justify-between gap-5">

                    <h3 class="text-[2.1rem] sm:text-4xl md:text-6xl lg:text-7xl font-bold transition-colors duration-300 group-hover:text-[#0066FF]">
                        Identidad visual
                    </h3>

                    <span class="text-[#0066FF] text-xl sm:text-2xl md:text-3xl shrink-0">
                        ↗
                    </span>

                </div>

                <div class="group py-5 sm:py-6 md:py-7 border-b border-[#292929] flex items-center justify-between gap-5">

                    <h3 class="text-[2.1rem] sm:text-4xl md:text-6xl lg:text-7xl font-bold transition-colors duration-300 group-hover:text-[#0066FF]">
                        Diseño web
                    </h3>

                    <span class="text-[#0066FF] text-xl sm:text-2xl md:text-3xl shrink-0">
                        ↗
                    </span>

                </div>

                <div class="group py-5 sm:py-6 md:py-7 border-b border-[#292929] flex items-center justify-between gap-5">

                    <h3 class="text-[2.1rem] sm:text-4xl md:text-6xl lg:text-7xl font-bold transition-colors duration-300 group-hover:text-[#0066FF]">
                        Campañas digitales
                    </h3>

                    <span class="text-[#0066FF] text-xl sm:text-2xl md:text-3xl shrink-0">
                        ↗
                    </span>

                </div>

                <div class="group py-5 sm:py-6 md:py-7 border-b border-[#292929] flex items-center justify-between gap-5">

                    <h3 class="text-[2.1rem] sm:text-4xl md:text-6xl lg:text-7xl font-bold transition-colors duration-300 group-hover:text-[#0066FF]">
                        Gestión de proyectos
                    </h3>

                    <span class="text-[#0066FF] text-xl sm:text-2xl md:text-3xl shrink-0">
                        ↗
                    </span>

                </div>

            </div>

        </div>

    </section>

    <!-- SELECTED WORK -->

    <section
        id="selected-work"
        class="bg-black text-white px-5 sm:px-6 md:px-12 lg:px-20 pt-5 sm:pt-6 md:pt-10 pb-10 md:pb-12"
    >

        <div class="max-w-[1400px] mx-auto">

            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-7 md:mb-10">

                <div>

                    <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                        Selected work
                    </p>

                    <h2 class="mt-3 md:mt-4 text-5xl sm:text-6xl md:text-7xl lg:text-[7rem] font-bold">
                        Algunos trabajos.
                    </h2>

                </div>

                <a
                    href="/works"
                    class="group inline-flex items-center gap-4 text-sm uppercase tracking-[0.15em] text-neutral-400 hover:text-white transition-colors"
                >

                    <span>
                        Ver todos
                    </span>

                    <span class="w-10 h-10 rounded-full bg-[#0066FF] text-white flex items-center justify-center group-hover:translate-x-1 transition-transform">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="w-5 h-5"
                            aria-hidden="true"
                        >
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>

                    </span>

                </a>

            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-10 md:gap-y-12">

                <!-- RECFCK -->

                <a
                    href="/works/recfck"
                    class="group block"
                >

                    <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] rounded-2xl">

                        <img
                            src={recfckImage.src}
                            alt="RECFCK — identidad visual"
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                        />

                        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>

                        <div class="absolute inset-0 flex items-end p-5 sm:p-6 md:p-8">

                            <div>

                                <p class="mb-3 text-xs uppercase tracking-[0.18em] text-[#0066FF]">
                                    Branding · 2025
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="mt-4 flex items-start justify-between gap-5">

                        <p class="max-w-md text-sm md:text-base text-neutral-500 leading-relaxed">
                            Identidad visual y dirección de arte para una marca con carácter, energía y un lenguaje gráfico propio.
                        </p>

                        <span class="text-[#0066FF] text-xl group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform shrink-0">
                            ↗
                        </span>

                    </div>

                    <div class="mt-4 h-px bg-[#292929] group-hover:bg-[#0066FF] transition-colors duration-300"></div>

                </a>

                <!-- LYNOX -->

                <a
                    href="/works/lynox"
                    class="group block md:mt-12"
                >

                    <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] rounded-2xl">

                        <img
                            src={lynoxImage.src}
                            alt="LYNOX — identidad visual"
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                        />

                        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>

                        <div class="absolute inset-0 flex items-end p-5 sm:p-6 md:p-8">

                            <div>

                                <p class="mb-3 text-xs uppercase tracking-[0.18em] text-[#0066FF]">
                                    Branding · 2026
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="mt-4 flex items-start justify-between gap-5">

                        <p class="max-w-md text-sm md:text-base text-neutral-500 leading-relaxed">
                            Identidad visual y dirección gráfica para una marca deportiva con un lenguaje sobrio, reconocible y contemporáneo.
                        </p>

                        <span class="text-[#0066FF] text-xl group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform shrink-0">
                            ↗
                        </span>

                    </div>

                    <div class="mt-4 h-px bg-[#292929] group-hover:bg-[#0066FF] transition-colors duration-300"></div>

                </a>

            </div>

        </div>

    </section>

    <!-- CONTACTO -->

    <section
        id="contact"
        class="bg-black text-white px-5 sm:px-6 md:px-12 lg:px-20 pt-5 sm:pt-6 md:pt-10 pb-8 md:pb-10"
    >

        <div class="max-w-[1400px] mx-auto">

            <div class="border-t border-[#292929] pt-6 sm:pt-7 md:pt-8">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Contacto
                </p>

            </div>

            <div class="mt-6 sm:mt-7 md:mt-8">

                <h2 class="text-[clamp(3.5rem,15vw,9rem)] sm:text-[clamp(4rem,12vw,9rem)] md:text-[clamp(4rem,10vw,9rem)] font-bold max-w-[1300px] leading-[1.05] md:leading-[1]">

                    Hablemos

                    <br />

                    de tu próximo

                    <br />

                    <span class="text-[#0066FF]">
                        proyecto.
                    </span>

                </h2>

            </div>

            <div class="mt-6 sm:mt-7 md:mt-8 flex flex-col md:flex-row md:items-end md:justify-between gap-7 md:gap-8">

                <p class="max-w-xl text-base sm:text-lg md:text-xl leading-relaxed text-neutral-400">
                    Si tienes una idea, un proyecto o simplemente quieres contarme qué tienes entre manos, escríbeme.
                </p>

                <a
                    href="/contact"
                    class="group inline-flex items-center gap-4 text-white text-base md:text-lg font-medium"
                    aria-label="Cuéntame tu idea"
                >

                    <span class="border-b border-white pb-1 group-hover:border-[#0066FF] transition-colors">
                        Cuéntame tu idea
                    </span>

                    <span class="w-11 h-11 md:w-12 md:h-12 rounded-full bg-[#0066FF] flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="w-5 h-5"
                            aria-hidden="true"
                        >
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>

                    </span>

                </a>

            </div>

        </div>

    </section>

</Layout>
---
import peter3 from "../../../assets/images/peter3.jpg";

const skills = [
    {
        title: "Identidad visual",
        text: "Concepto, dirección visual, logotipos y sistemas gráficos coherentes para construir marcas reconocibles."
    },
    {
        title: "Diseño web",
        text: "Diseño de páginas web responsive y trabajo con WordPress, Elementor, HTML y CSS."
    },
    {
        title: "Campañas digitales",
        text: "Diseño de contenidos para redes sociales y campañas digitales, incluyendo trabajo con Meta Ads."
    },
    {
        title: "Diseño gráfico",
        text: "Composición, tipografía, imagen y diseño editorial para soportes digitales e impresos."
    },
    {
        title: "Gestión de proyectos",
        text: "Organización, planificación, seguimiento de tareas, coordinación de entregas y resolución de incidencias."
    },
    {
        title: "Cliente y comunicación",
        text: "Atención al cliente, seguimiento mediante CRM y comunicación durante las diferentes fases de un proyecto."
    },
    {
        title: "Herramientas creativas",
        text: "Photoshop, Illustrator, InDesign, Premiere Pro, After Effects, Lightroom y Procreate."
    },
    {
        title: "IA aplicada al diseño",
        text: "Uso de herramientas de inteligencia artificial para explorar conceptos, generar recursos y acelerar procesos creativos."
    }
];
---

<section class="max-w-7xl mx-auto px-6 md:px-10 pt-32 pb-24">

    <!-- CABECERA -->
    <header class="mb-16 md:mb-20">

        <div class="flex items-end justify-end gap-6 mb-6">
            <span class="hidden md:block text-neutral-500 text-sm">
                YerxCreative / Sobre mí
            </span>
        </div>

        <div class="border-t border-[#292929] pt-8">
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-[-0.05em] leading-[0.9] text-white max-w-5xl">
                Sobre mí
            </h1>
        </div>

    </header>


    <!-- PRESENTACIÓN -->
    <div class="grid md:grid-cols-[1fr_360px] gap-12 md:gap-20 items-start">

        <!-- TEXTO -->
        <div>

            <p class="text-2xl md:text-4xl lg:text-5xl font-bold tracking-[-0.03em] leading-tight text-white max-w-4xl">
                Diseño, proyectos y creatividad para convertir ideas en experiencias visuales.
            </p>

            <div class="mt-10 max-w-2xl space-y-6 text-neutral-400 text-base md:text-lg leading-relaxed">

                <p>
                    Soy Yeray Díaz Cortina, diseñador digital y de proyectos.
                    Trabajo en diseño web, campañas digitales, identidad visual
                    y gestión de proyectos.
                </p>

                <p>
                    Me gusta involucrarme en todo el proceso: entender el proyecto,
                    organizarlo, desarrollar la parte visual y llevarlo hasta la entrega.
                    Combino diseño y tecnología con una forma de trabajar cercana,
                    organizada y orientada a resultados.
                </p>

            </div>

        </div>


        <!-- FOTO -->
        <div class="border border-[#292929] p-3">
            <img
                src={peter3.src}
                alt="Yeray Díaz, diseñador digital y de proyectos"
                class="w-full h-auto object-cover"
            />
        </div>

    </div>


    <!-- LO QUE SÉ HACER -->
    <section class="mt-32 md:mt-40">

        <header class="mb-12">

            <div class="flex items-end justify-end gap-6 mb-6">
                <span class="hidden md:block text-neutral-500 text-sm">
                    Habilidades
                </span>
            </div>

            <div class="border-t border-[#292929] pt-8">

                <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-[-0.05em] leading-[0.9] text-white">
                    Lo que sé hacer
                </h2>

            </div>

        </header>


        <!-- LISTA DE HABILIDADES -->
        <div class="border-t border-[#292929]">

            {skills.map((skill) => (
                <article class="py-8 border-b border-[#292929]">

                    <div>

                        <h3 class="text-2xl md:text-3xl font-bold tracking-[-0.03em] text-white">
                            {skill.title}
                        </h3>

                        <p class="mt-4 max-w-2xl text-neutral-400 leading-relaxed">
                            {skill.text}
                        </p>

                    </div>

                </article>
            ))}

        </div>

    </section>


    <!-- CIERRE -->
    <section class="mt-32 md:mt-40">

        <div class="border-t border-[#292929] pt-8">

            <p class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-[-0.04em] leading-tight text-white max-w-5xl">
                Diseño con intención.
                <span class="text-[#0066FF]">Creatividad con criterio.</span>
            </p>

        </div>

    </section>

</section>
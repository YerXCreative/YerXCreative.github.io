---
import ImageContainer from "./ImageContainer.astro";

export interface Props {
    slug: string;
    featuredImage: string;
    title: string;
    client: string;
    category: string;
}

const { slug, featuredImage, title, client, category } = Astro.props;
---

<a href={`/works/${slug}`} class="group block">
    <!-- Imagen con efecto sutil de zoom al pasar el ratón -->
    <div class="aspect-[4/3] bg-base-200 rounded-sm overflow-hidden mb-4 shadow-sm group-hover:shadow-md transition-shadow duration-300">
        <ImageContainer 
            src={featuredImage} 
            alt={title} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
        />
    </div>
    
    <!-- Texto limpio y jerárquico -->
    <div class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wider text-base-500">{category}</span>
        <h3 class="text-xl font-bold text-base-900 group-hover:text-base-700 transition-colors">{title}</h3>
        <span class="text-sm text-base-600">{client}</span>
    </div>
</a>
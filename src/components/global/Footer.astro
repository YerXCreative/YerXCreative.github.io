---
const socials = [
    {
        title: "Instagram",
        href: "https://www.instagram.com/yerxcreative/",
    },
    {
        title: "Threads",
        href: "https://www.threads.com/@yerxcreative?hl=es",
    },
];
---

<footer class="border-t border-[#292929] mt-32">

    <div class="max-w-7xl mx-auto px-6 md:px-10 py-12">

        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10">

            <!-- Marca -->
            <div>
                <a
                    href="/"
                    class="text-white text-xl font-bold tracking-[-0.03em] hover:text-[#0066FF] transition-colors"
                >
                    YerxCreative
                </a>

                <p class="mt-3 text-neutral-500 text-sm">
                    Diseño digital y de proyectos.
                </p>
            </div>


            <!-- Contacto -->
            <div class="flex flex-col gap-3">

                <span class="text-[#0066FF] text-xs uppercase tracking-[0.15em]">
                    Contacto
                </span>

                <a
                    href="mailto:yeraydxz@gmail.com"
                    class="text-white hover:text-[#0066FF] transition-colors"
                >
                    yeraydxz@gmail.com
                </a>

                <a
                    href="https://wa.me/34697601146?text=Hola%20Yeray%2C%20me%20gustar%C3%ADa%20hablar%20contigo%20sobre%20un%20proyecto.%20%C2%BFPodemos%20comentar%20los%20detalles%3F"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-white hover:text-[#0066FF] transition-colors"
                >
                    WhatsApp
                </a>

            </div>


            <!-- Redes -->
            <div class="flex flex-col gap-3">

                <span class="text-[#0066FF] text-xs uppercase tracking-[0.15em]">
                    Redes
                </span>

                {socials.map((social) => (
                    <a
                        href={social.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-white hover:text-[#0066FF] transition-colors"
                    >
                        {social.title}
                    </a>
                ))}

            </div>

        </div>


        <!-- Copyright -->
        <div class="mt-12 pt-6 border-t border-[#292929] flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-neutral-500 text-sm">

            <span>
                YerxCreative © {new Date().getFullYear()}
            </span>

            <span>
                Diseñado por Yeray Díaz
            </span>

        </div>

    </div>

</footer>
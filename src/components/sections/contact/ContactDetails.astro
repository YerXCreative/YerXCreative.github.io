---

<section class="max-w-7xl mx-auto px-6 md:px-10">

    <div class="border-t border-[#0066FF]">

        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8 py-7">

            <!-- Marca -->
            <div class="flex items-center gap-2 shrink-0">

                <span class="text-white font-bold text-lg tracking-[-0.03em]">
                    YerxCreative
                </span>

                <span class="text-neutral-500 text-sm">
                    © {new Date().getFullYear()}
                </span>

            </div>


            <!-- Contacto -->
            <div class="flex flex-wrap items-center gap-3">

                <!-- WhatsApp -->
                <a
                    href="https://wa.me/34697601146?text=Hola%20Yeray%2C%20me%20gustar%C3%ADa%20hablar%20contigo%20sobre%20un%20proyecto.%20%C2%BFPodemos%20comentar%20los%20detalles%3F"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-full border border-[#292929] px-4 py-2.5 text-sm text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors"
                >
                    <span>WhatsApp</span>

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-4 h-4"
                    >
                        <path d="M20 11.5a8.5 8.5 0 0 1-12.9 7.2L4 20l1.3-3A8.5 8.5 0 1 1 20 11.5Z" />
                        <path d="M8.5 9.2c.3-.7.6-.7 1-.7h.5c.2 0 .4.1.5.4l.7 1.6c.1.3.1.5-.1.7l-.5.6c.7 1.3 1.7 2.2 3 2.9l.6-.5c.2-.2.4-.2.7-.1l1.5.7c.3.1.4.3.4.5v.5c0 .4 0 .7-.7 1-.5.2-1.1.2-1.7 0-2.8-.8-5.5-3.5-6.3-6.3-.2-.6-.2-1.2 0-1.7Z" />
                    </svg>
                </a>


                <!-- Email -->
                <a
                    href="mailto:yeraydxz@gmail.com"
                    class="inline-flex items-center gap-2 rounded-full border border-[#292929] px-4 py-2.5 text-sm text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors"
                >
                    <span>Email</span>

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-4 h-4"
                    >
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m3 7 9 6 9-6" />
                    </svg>
                </a>


                <!-- Instagram -->
                <a
                    href="https://www.instagram.com/yerxcreative/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center rounded-full border border-[#292929] px-4 py-2.5 text-sm text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors"
                >
                    Instagram
                </a>


                <!-- Threads -->
                <a
                    href="https://www.threads.com/@yerxcreative?hl=es"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center rounded-full border border-[#292929] px-4 py-2.5 text-sm text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors"
                >
                    Threads
                </a>

            </div>


            <!-- Firma -->
            <span class="text-neutral-500 text-sm shrink-0">
                Diseñado por Yeray Díaz
            </span>

        </div>

    </div>

</section>
---
---

<section class="max-w-7xl mx-auto px-6 md:px-10 pb-32">

    <!-- Datos de contacto -->
    <div class="grid md:grid-cols-3 border-t border-[#292929]">

        <!-- Email -->
        <a
            href="mailto:yeraydxz@gmail.com"
            class="py-8 md:pr-8 border-b md:border-b-0 md:border-r border-[#292929] group"
        >
            <span class="text-[#0066FF] text-xs uppercase tracking-[0.15em]">
                Email
            </span>

            <h2 class="mt-4 text-xl md:text-2xl font-bold text-white group-hover:text-[#0066FF] transition-colors">
                yeraydxz@gmail.com
            </h2>
        </a>

        <!-- WhatsApp -->
        <a
            href="https://wa.me/34697601146?text=Hola%20Yeray%2C%20me%20gustar%C3%ADa%20hablar%20contigo%20sobre%20un%20proyecto.%20%C2%BFPodemos%20comentar%20los%20detalles%3F"
            target="_blank"
            rel="noopener noreferrer"
            class="py-8 md:px-8 border-b md:border-b-0 md:border-r border-[#292929] group"
        >
            <span class="text-[#0066FF] text-xs uppercase tracking-[0.15em]">
                WhatsApp
            </span>

            <h2 class="mt-4 text-xl md:text-2xl font-bold text-white group-hover:text-[#0066FF] transition-colors">
                Hablemos
            </h2>
        </a>

        <!-- Instagram -->
        <a
            href="https://instagram.com/yerxcreative"
            target="_blank"
            rel="noopener noreferrer"
            class="py-8 md:pl-8 group"
        >
            <span class="text-[#0066FF] text-xs uppercase tracking-[0.15em]">
                Instagram
            </span>

            <h2 class="mt-4 text-xl md:text-2xl font-bold text-white group-hover:text-[#0066FF] transition-colors">
                @yerxcreative
            </h2>
        </a>

    </div>


    <!-- Formulario -->
    <div class="mt-24 max-w-4xl">

        <div class="mb-10">
            <span class="text-[#0066FF] text-xs uppercase tracking-[0.15em]">
                ¿Tienes un proyecto?
            </span>

            <h2 class="mt-4 text-3xl md:text-5xl font-bold tracking-[-0.04em] text-white">
                Cuéntame qué tienes en mente.
            </h2>
        </div>


        <form
            action="https://formsubmit.co/yeraydxz@gmail.com"
            method="POST"
            class="flex flex-col gap-8"
        >

            <input
                type="hidden"
                name="_subject"
                value="Nuevo mensaje desde YerxCreative"
            />

            <input
                type="hidden"
                name="_next"
                value="https://yerxcreative.github.io/gracias"
            />

            <input
                type="hidden"
                name="_captcha"
                value="false"
            />


            <!-- Nombre -->
            <div class="flex flex-col gap-3">

                <label
                    for="name"
                    class="text-sm text-neutral-400"
                >
                    Nombre
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Tu nombre"
                    class="w-full bg-transparent border-b border-[#292929] py-4 text-white placeholder:text-neutral-600 focus:outline-none focus:border-[#0066FF] transition-colors"
                />

            </div>


            <!-- Email -->
            <div class="flex flex-col gap-3">

                <label
                    for="email"
                    class="text-sm text-neutral-400"
                >
                    Correo electrónico
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="tu@email.com"
                    class="w-full bg-transparent border-b border-[#292929] py-4 text-white placeholder:text-neutral-600 focus:outline-none focus:border-[#0066FF] transition-colors"
                />

            </div>


            <!-- Mensaje -->
            <div class="flex flex-col gap-3">

                <label
                    for="message"
                    class="text-sm text-neutral-400"
                >
                    Mensaje
                </label>

                <textarea
                    id="message"
                    name="message"
                    rows="5"
                    required
                    placeholder="Cuéntame sobre tu proyecto..."
                    class="w-full bg-transparent border-b border-[#292929] py-4 text-white placeholder:text-neutral-600 focus:outline-none focus:border-[#0066FF] transition-colors resize-none"
                ></textarea>

            </div>


            <!-- Botón -->
            <button
                type="submit"
                class="self-start mt-2 px-7 py-4 bg-[#0066FF] text-white font-semibold hover:bg-[#1687FF] transition-colors cursor-pointer"
            >
                Enviar mensaje →
            </button>

        </form>

    </div>

</section>
---
import Layout from "../layouts/Layout.astro";
import peter from "../assets/images/peter.jpg";
---

<Layout
    title="Yeray Díaz — Diseñador Digital"
    description="Portfolio de Yeray Díaz, diseñador digital y de proyectos."
>

    <!-- HERO -->

    <section class="relative bg-black text-white min-h-screen flex flex-col justify-between px-6 md:px-12 lg:px-20 pt-32 pb-8 overflow-hidden">

        <div class="max-w-[1400px] mx-auto w-full flex items-center justify-between text-[10px] md:text-xs uppercase tracking-[0.2em] text-neutral-500">

            <span>
                Diseñador digital & proyectos
            </span>

            <span class="hidden sm:block">
                Gijón · Asturias
            </span>

        </div>


        <div class="max-w-[1400px] mx-auto w-full flex-1 flex items-center py-16 md:py-20">

            <div>

                <div class="flex items-center gap-4 mb-8">

                    <span class="w-2 h-2 rounded-full bg-[#0066FF]"></span>

                    <p class="text-[#0066FF] text-sm md:text-base font-bold uppercase tracking-[0.2em]">
                        Hola, soy Yeray
                    </p>

                </div>


                <h1 class="text-[clamp(4rem,11vw,10rem)] leading-[0.82] font-bold tracking-[-0.07em] uppercase max-w-[1300px]">

                    Diseño
                    <br />

                    digital que
                    <br />

                    <span class="text-neutral-500">
                        no parece
                    </span>

                    <br />

                    hecho por un robot.

                </h1>

            </div>

        </div>


        <div class="max-w-[1400px] mx-auto w-full flex flex-col md:flex-row md:items-end justify-between gap-10">

            <p class="max-w-lg text-base md:text-lg text-neutral-400 leading-relaxed">
                Diseño, web, campañas y proyectos digitales
                con una mezcla bastante seria de creatividad,
                estrategia y criterio.
            </p>


            <a
                href="#about-preview"
                aria-label="Bajar a sobre mí"
                class="group flex items-center gap-4"
            >

                <span class="hidden md:block text-xs uppercase tracking-[0.2em] text-neutral-500">
                    Conóceme
                </span>

                <span class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-[#0066FF] text-white flex items-center justify-center group-hover:scale-110 transition-transform">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="w-6 h-6 md:w-7 md:h-7"
                        aria-hidden="true"
                    >
                        <path d="M12 5v14" />
                        <path d="m19 12-7 7-7-7" />
                    </svg>

                </span>

            </a>

        </div>

    </section>


    <!-- SOBRE MÍ -->

    <section
        id="about-preview"
        class="bg-black text-white px-6 md:px-12 lg:px-20 py-20 md:py-32"
    >

        <div class="max-w-[1400px] mx-auto">

            <div class="mb-14 md:mb-20">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Sobre mí
                </p>

            </div>


            <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-24 items-center">

                <!-- TEXTO -->

                <div>

                    <h2 class="text-5xl md:text-7xl lg:text-[7rem] font-bold leading-[0.86] tracking-[-0.06em] mb-10">

                        Diseño.
                        <br />

                        Proyectos.
                        <br />

                        Personas.

                    </h2>


                    <div class="max-w-xl space-y-6 text-lg md:text-xl leading-relaxed text-neutral-400">

                        <p>
                            Soy Yeray Díaz, diseñador digital y de proyectos.
                        </p>

                        <p>
                            Trabajo en diseño web, campañas digitales,
                            identidad visual y gestión de proyectos,
                            llevando las ideas desde el briefing hasta la entrega.
                        </p>

                        <p>
                            Me interesa que las cosas funcionen,
                            pero también que tengan algo que decir.
                        </p>

                    </div>

                </div>


                <!-- FOTO -->

                <div class="relative">

                    <div class="absolute -top-4 -left-4 w-full h-full border-2 border-[#0066FF]"></div>

                    <div class="relative bg-[#0A0A0A] p-3 border border-[#292929] overflow-hidden">

                        <img
                            src={peter.src}
                            alt="Yeray Díaz, diseñador digital y de proyectos"
                            class="w-full h-auto object-cover"
                        />

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- LO QUE HAGO -->

    <section class="bg-black text-white px-6 md:px-12 lg:px-20 py-20 md:py-32">

        <div class="max-w-[1400px] mx-auto">

            <div class="mb-16 md:mb-20">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Lo que hago
                </p>

            </div>


            <div class="border-t border-[#292929]">

                <div class="py-8 md:py-10 border-b border-[#292929]">

                    <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-[-0.04em]">
                        Identidad visual
                    </h3>

                </div>


                <div class="py-8 md:py-10 border-b border-[#292929]">

                    <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-[-0.04em]">
                        Diseño web
                    </h3>

                </div>


                <div class="py-8 md:py-10 border-b border-[#292929]">

                    <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-[-0.04em]">
                        Campañas digitales
                    </h3>

                </div>


                <div class="py-8 md:py-10 border-b border-[#292929]">

                    <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-[-0.04em]">
                        Gestión de proyectos
                    </h3>

                </div>

            </div>

        </div>

    </section>


    <!-- SELECTED WORK -->

    <section
        id="selected-work"
        class="bg-black text-white px-6 md:px-12 lg:px-20 py-20 md:py-32"
    >

        <div class="max-w-[1400px] mx-auto">

            <div class="mb-16 md:mb-20">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Selected work
                </p>

                <p class="mt-2 text-sm text-neutral-600">
                    Algunos proyectos y trabajos
                </p>

            </div>


            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-16 md:gap-y-20">


                <a href="/works" class="group block">

                    <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-[#292929]">

                        <div class="absolute inset-0 flex items-end p-6 md:p-8">

                            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.05em] leading-[0.9] text-white">
                                Nombre de<br />
                                proyecto
                            </h2>

                        </div>

                    </div>


                    <div class="mt-5 flex items-start justify-between gap-6">

                        <div>

                            <h3 class="text-xl md:text-2xl font-bold tracking-[-0.03em]">
                                Nombre de proyecto
                            </h3>

                            <p class="mt-2 text-sm text-neutral-500">
                                Descripción del proyecto
                            </p>

                        </div>


                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5 text-[#0066FF] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                            aria-hidden="true"
                        >
                            <path d="M7 17 17 7" />
                            <path d="M7 7h10v10" />
                        </svg>

                    </div>

                    <div class="mt-5 border-b border-[#292929] group-hover:border-[#0066FF] transition-colors duration-300"></div>

                </a>


                <a href="/works" class="group block">

                    <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-[#292929]">

                        <div class="absolute inset-0 flex items-end p-6 md:p-8">

                            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.05em] leading-[0.9] text-white">
                                Nombre de<br />
                                proyecto
                            </h2>

                        </div>

                    </div>


                    <div class="mt-5 flex items-start justify-between gap-6">

                        <div>

                            <h3 class="text-xl md:text-2xl font-bold tracking-[-0.03em]">
                                Nombre de proyecto
                            </h3>

                            <p class="mt-2 text-sm text-neutral-500">
                                Descripción del proyecto
                            </p>

                        </div>


                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5 text-[#0066FF] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                            aria-hidden="true"
                        >
                            <path d="M7 17 17 7" />
                            <path d="M7 7h10v10" />
                        </svg>

                    </div>

                    <div class="mt-5 border-b border-[#292929] group-hover:border-[#0066FF] transition-colors duration-300"></div>

                </a>


                <a href="/works" class="group block">

                    <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-[#292929]">

                        <div class="absolute inset-0 flex items-end p-6 md:p-8">

                            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.05em] leading-[0.9] text-white">
                                Nombre de<br />
                                proyecto
                            </h2>

                        </div>

                    </div>


                    <div class="mt-5 flex items-start justify-between gap-6">

                        <div>

                            <h3 class="text-xl md:text-2xl font-bold tracking-[-0.03em]">
                                Nombre de proyecto
                            </h3>

                            <p class="mt-2 text-sm text-neutral-500">
                                Descripción del proyecto
                            </p>

                        </div>


                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5 text-[#0066FF] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                            aria-hidden="true"
                        >
                            <path d="M7 17 17 7" />
                            <path d="M7 7h10v10" />
                        </svg>

                    </div>

                    <div class="mt-5 border-b border-[#292929] group-hover:border-[#0066FF] transition-colors duration-300"></div>

                </a>


                <a href="/works" class="group block">

                    <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-[#292929]">

                        <div class="absolute inset-0 flex items-end p-6 md:p-8">

                            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.05em] leading-[0.9] text-white">
                                Nombre de<br />
                                proyecto
                            </h2>

                        </div>

                    </div>


                    <div class="mt-5 flex items-start justify-between gap-6">

                        <div>

                            <h3 class="text-xl md:text-2xl font-bold tracking-[-0.03em]">
                                Nombre de proyecto
                            </h3>

                            <p class="mt-2 text-sm text-neutral-500">
                                Descripción del proyecto
                            </p>

                        </div>


                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5 text-[#0066FF] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                            aria-hidden="true"
                        >
                            <path d="M7 17 17 7" />
                            <path d="M7 7h10v10" />
                        </svg>

                    </div>

                    <div class="mt-5 border-b border-[#292929] group-hover:border-[#0066FF] transition-colors duration-300"></div>

                </a>

            </div>

        </div>

    </section>


    <!-- CONTACTO -->

    <section
        id="contact"
        class="bg-black text-white px-6 md:px-12 lg:px-20 pt-24 md:pt-32 pb-20 md:pb-24"
    >

        <div class="max-w-[1400px] mx-auto">

            <div class="mb-10 md:mb-12">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Contacto
                </p>

            </div>


            <h2 class="text-[clamp(3.5rem,9vw,8rem)] leading-[0.85] font-bold tracking-[-0.06em] max-w-6xl">

                Hablemos
                <br />

                de tu próximo
                <br />

                proyecto.

            </h2>


            <div class="mt-12 md:mt-16 flex flex-col md:flex-row md:items-end md:justify-between gap-8">

                <p class="max-w-xl text-lg md:text-xl leading-relaxed text-neutral-400">
                    Si tienes una idea, un proyecto o simplemente quieres
                    contarme qué tienes entre manos, escríbeme.
                </p>


                <a
                    href="mailto:yeraydxz@gmail.com"
                    class="group inline-flex items-center gap-4 text-white text-base md:text-lg font-medium"
                >

                    <span class="border-b border-white pb-1 group-hover:border-[#0066FF] transition-colors">
                        yeraydxz@gmail.com
                    </span>

                    <span class="w-10 h-10 rounded-full bg-[#0066FF] flex items-center justify-center group-hover:scale-110 transition-transform">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="w-5 h-5"
                            aria-hidden="true"
                        >
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>

                    </span>

                </a>

            </div>

        </div>

    </section>

</Layout>
---
// layout
import Layout from '../layouts/Layout.astro';

// assets
import peter from "../assets/images/peter.jpg";
---

<Layout 
    title="Yeray Díaz - Diseñador Gráfico y Web"
    description="Director de Arte y Diseñador Gráfico. Combino creatividad y herramientas de IA para crear marcas únicas."
>
    <!-- HEADER SIMPLE -->
    <header class="w-full py-6 px-12 flex justify-center items-center bg-[#2d1b4e]">
        <nav class="flex gap-8 text-sm font-medium">
            <a href="/" class="text-[#ccff00] bg-[#ccff00] text-[#2d1b4e] px-4 py-2 rounded">Home</a>
            <a href="/works" class="text-white hover:text-[#ccff00] transition-colors">Work</a>
            <a href="/about" class="text-white hover:text-[#ccff00] transition-colors">Resumé</a>
        </nav>
    </header>

    <!-- SECCIÓN 1: HOLA! SOY YERAY -->
    <section class="w-full bg-[#2d1b4e] py-16 px-6 md:px-24">
        <div class="max-w-6xl mx-auto">
            <h1 class="text-5xl md:text-7xl font-bold text-[#ccff00] mb-12 text-center">
                ¡Hola! Soy Yeray
            </h1>
            
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="text-white text-lg leading-relaxed space-y-6">
                    <p>
                        Soy Yeray Díaz, un Diseñador Gráfico y Web. Me especializo en crear identidades visuales y experiencias digitales que ayudan a las marcas a destacar.
                    </p>
                    <p>
                        A lo largo de mi carrera, he colaborado con grandes empresas y startups, trabajando en todo, desde campañas integrales hasta proyectos de alto impacto. Mi experiencia abarca diseño digital, branding y dirección de arte.
                    </p>
                </div>
                
                <div class="flex justify-center">
                    <div class="w-full max-w-md aspect-[3/4] overflow-hidden rounded-lg">
                        <img 
                            src={peter.src} 
                            alt="Yeray Díaz" 
                            class="w-full h-full object-cover"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: NO SOY UN ROBOT -->
    <section class="w-full bg-[#2d1b4e] py-16 px-6 md:px-24">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-4xl md:text-5xl font-bold text-[#ccff00] mb-8">
                No soy un robot.
            </h2>
            <p class="text-white text-lg leading-relaxed">
                Por eso aporto un toque humano a cada proyecto, combinando creatividad estratégica con las últimas herramientas de Inteligencia Artificial para optimizar procesos, ahorrar tiempo y entregar un trabajo excepcional. Al abrazar la innovación, ayudo a asegurar que tu marca deje una huella positiva y duradera.
            </p>
        </div>
    </section>

    <!-- SECCIÓN 3: OTROS DATOS SOBRE MÍ -->
    <section class="w-full bg-[#2d1b4e] py-16 px-6 md:px-24">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-4xl md:text-5xl font-bold text-[#ccff00] mb-8">
                Otros datos sobre mí.
            </h2>
            <ul class="text-white text-lg space-y-3 list-disc list-inside">
                <li>Amante del diseño minimalista y la fotografía urbana.</li>
                <li>Adicto a la cafeína: café negro para despertar y un latte como premio.</li>
                <li>Entusiasta de la tecnología y siempre experimentando con nuevas herramientas creativas.</li>
                <li>Creo firmemente que el buen diseño resuelve problemas y genera conexiones.</li>
            </ul>
        </div>
    </section>

    <!-- FOOTER: PHONE / EMAIL / CONNECT -->
    <footer class="w-full bg-[#7c3aed] py-16 px-6">
        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-12 text-center">
            <!-- Phone -->
            <div>
                <div class="text-3xl mb-4">📞</div>
                <h3 class="text-[#00ffff] text-xl font-bold mb-2">Phone</h3>
                <p class="text-white text-sm">+34 600 000 000</p>
            </div>

            <!-- Email -->
            <div>
                <div class="text-3xl mb-4">✉️</div>
                <h3 class="text-[#00ffff] text-xl font-bold mb-2">Email</h3>
                <p class="text-white text-sm">yerxcreativestudio@gmail.com</p>
            </div>

            <!-- Connect -->
            <div>
                <div class="text-3xl mb-4">👍</div>
                <h3 class="text-[#00ffff] text-xl font-bold mb-2">Connect</h3>
                <div class="flex justify-center gap-4 text-white text-sm">
                    <a href="https://www.instagram.com/yerxcreative/" target="_blank" class="hover:text-[#00ffff] transition-colors">Instagram</a>
                    <a href="https://www.threads.com/@yerxcreative" target="_blank" class="hover:text-[#00ffff] transition-colors">Threads</a>
                </div>
            </div>
        </div>
    </footer>
</Layout>
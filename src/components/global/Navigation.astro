---
const navLinks = [
    { title: "Home", href: "/" },
    { title: "Work", href: "/works" },
    { title: "Resumé", href: "/about" }
]
---

<nav class="w-full bg-white py-4 px-12 flex justify-between items-center fixed top-0 left-0 right-0 z-50">
    <!-- Espacio vacío izquierda -->
    <div style="width: 200px;"></div>
    
    <!-- Logo centrado -->
    <a href="/" class="text-[#2d1b4e] font-bold text-sm tracking-[0.3em] uppercase">
        YerxCreative
    </a>
    
    <!-- Botones derecha -->
    <ul class="flex gap-1">
        {navLinks.map((link, index) => (
            <li>
                <a 
                    href={link.href} 
                    class={`px-4 py-2 text-sm font-medium rounded-sm ${
                        index === 0 
                            ? 'bg-[#ccff00] text-[#2d1b4e]' 
                            : 'text-[#2d1b4e] hover:bg-gray-100'
                    }`}
                >
                    {link.title}
                </a>
            </li>
        ))}
    </ul>
</nav>
---
import Layout from "../layouts/Layout.astro";
import peter from "../assets/images/peter.jpg";
---

<style>
    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(40px);
        transition:
            opacity 800ms cubic-bezier(0.22, 1, 0.36, 1),
            transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: opacity, transform;
    }

    .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
        .reveal-on-scroll {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>

<Layout
    title="Yeray Díaz — Diseñador Digital"
    description="Portfolio de Yeray Díaz, diseñador digital y de proyectos."
>

    <!-- HERO -->

    <section class="relative bg-black text-white min-h-screen flex flex-col justify-between px-6 md:px-12 lg:px-20 pt-20 pb-8 overflow-hidden">

        <div class="max-w-[1400px] mx-auto w-full flex items-center justify-between text-[10px] md:text-xs uppercase tracking-[0.2em] text-neutral-500">

            <span>
                Diseñador digital & proyectos
            </span>

            <span class="hidden sm:block">
                Gijón · Asturias
            </span>

        </div>


        <div class="max-w-[1400px] mx-auto w-full flex-1 flex items-center py-10 md:py-12">

            <div class="w-full">

                <div class="flex items-center gap-4 mb-8">

                    <span class="w-2 h-2 rounded-full bg-[#0066FF]"></span>

                    <p class="text-[#0066FF] text-sm md:text-base font-bold uppercase tracking-[0.16em]">
                        Hola, soy Yeray
                    </p>

                </div>


                <h1 class="text-[clamp(4.5rem,12vw,11rem)] font-bold uppercase max-w-[1400px]">

                    Diseño con cabeza.
                    <br />

                    <span class="text-[#0066FF]">
                        Creatividad con actitud.
                    </span>

                </h1>

            </div>

        </div>


        <div class="max-w-[1400px] mx-auto w-full flex flex-col md:flex-row md:items-end md:justify-between gap-8">

            <p class="max-w-lg text-base md:text-lg text-neutral-400 leading-relaxed">
                Diseño, web, campañas y proyectos digitales
                con una mezcla bastante seria de creatividad,
                estrategia y criterio.
            </p>


            <a
                href="#about-preview"
                aria-label="Bajar a sobre mí"
                class="group flex items-center gap-4 self-start md:self-auto"
            >

                <span class="hidden md:block text-xs uppercase tracking-[0.2em] text-neutral-500">
                    Conóceme
                </span>

                <span class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-[#0066FF] text-white flex items-center justify-center group-hover:scale-110 transition-transform">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="w-6 h-6 md:w-7 md:h-7"
                        aria-hidden="true"
                    >
                        <path d="M12 5v14" />
                        <path d="m19 12-7 7-7-7" />
                    </svg>

                </span>

            </a>

        </div>

    </section>


    <!-- SOBRE MÍ -->

    <section
        id="about-preview"
        class="reveal-on-scroll bg-black text-white px-6 md:px-12 lg:px-20 py-10 md:py-16"
    >

        <div class="max-w-[1400px] mx-auto">

            <div class="mb-8 md:mb-10">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Sobre mí
                </p>

            </div>


            <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-20 items-center">

                <!-- TEXTO -->

                <div>

                    <h2 class="text-5xl md:text-7xl lg:text-[7rem] font-bold mb-7">

                        <span class="text-[#0066FF]">
                            Diseño.
                        </span>
                        <br />

                        Proyectos.
                        <br />

                        Personas.

                    </h2>


                    <div class="max-w-xl space-y-5 text-lg md:text-xl leading-relaxed text-neutral-400">

                        <p>
                            Soy Yeray Díaz, diseñador digital y de proyectos.
                        </p>

                        <p>
                            Trabajo en diseño web, campañas digitales,
                            identidad visual y gestión de proyectos,
                            llevando las ideas desde el briefing hasta la entrega.
                        </p>

                        <p>
                            Me interesa que las cosas funcionen,
                            pero también que tengan algo que decir.
                        </p>

                    </div>

                </div>


                <!-- FOTO -->

                <div class="relative">

                    <div class="absolute -top-4 -left-4 w-full h-full border-2 border-[#0066FF]"></div>

                    <div class="relative bg-[#0A0A0A] p-3 border border-[#292929] overflow-hidden">

                        <img
                            src={peter.src}
                            alt="Yeray Díaz, diseñador digital y de proyectos"
                            class="w-full h-auto object-cover"
                        />

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- LO QUE HAGO -->

    <section class="reveal-on-scroll bg-black text-white px-6 md:px-12 lg:px-20 py-10 md:py-16">

        <div class="max-w-[1400px] mx-auto">

            <div class="mb-8 md:mb-10">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Lo que hago
                </p>

            </div>


            <div class="border-t border-[#292929]">

                <div class="py-5 md:py-7 border-b border-[#292929]">

                    <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold">
                        Identidad visual
                    </h3>

                </div>


                <div class="py-5 md:py-7 border-b border-[#292929]">

                    <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold">
                        Diseño web
                    </h3>

                </div>


                <div class="py-5 md:py-7 border-b border-[#292929]">

                    <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold">
                        Campañas digitales
                    </h3>

                </div>


                <div class="py-5 md:py-7 border-b border-[#292929]">

                    <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold">
                        Gestión de proyectos
                    </h3>

                </div>

            </div>

        </div>

    </section>


    <!-- SELECTED WORK -->

    <section
        id="selected-work"
        class="reveal-on-scroll bg-black text-white px-6 md:px-12 lg:px-20 py-10 md:py-16"
    >

        <div class="max-w-[1400px] mx-auto">

            <div class="mb-8 md:mb-10">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Selected work
                </p>

                <p class="mt-2 text-sm text-neutral-600">
                    Algunos proyectos y trabajos
                </p>

            </div>


            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-12 md:gap-y-14">

                <a href="/works" class="group block">

                    <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-[#292929]">

                        <div class="absolute inset-0 flex items-end p-6 md:p-8">

                            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white">
                                Nombre de<br />
                                proyecto
                            </h2>

                        </div>

                    </div>


                    <div class="mt-5 flex items-start justify-between gap-6">

                        <div>

                            <h3 class="text-xl md:text-2xl font-bold">
                                Nombre de proyecto
                            </h3>

                            <p class="mt-2 text-sm text-neutral-500">
                                Descripción del proyecto
                            </p>

                        </div>


                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5 text-[#0066FF] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                            aria-hidden="true"
                        >
                            <path d="M7 17 17 7" />
                            <path d="M7 7h10v10" />
                        </svg>

                    </div>


                    <div class="mt-5 border-b border-[#292929] group-hover:border-[#0066FF] transition-colors duration-300"></div>

                </a>


                <a href="/works" class="group block">

                    <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-[#292929]">

                        <div class="absolute inset-0 flex items-end p-6 md:p-8">

                            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white">
                                Nombre de<br />
                                proyecto
                            </h2>

                        </div>

                    </div>


                    <div class="mt-5 flex items-start justify-between gap-6">

                        <div>

                            <h3 class="text-xl md:text-2xl font-bold">
                                Nombre de proyecto
                            </h3>

                            <p class="mt-2 text-sm text-neutral-500">
                                Descripción del proyecto
                            </p>

                        </div>


                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5 text-[#0066FF] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                            aria-hidden="true"
                        >
                            <path d="M7 17 17 7" />
                            <path d="M7 7h10v10" />
                        </svg>

                    </div>


                    <div class="mt-5 border-b border-[#292929] group-hover:border-[#0066FF] transition-colors duration-300"></div>

                </a>


                <a href="/works" class="group block">

                    <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-[#292929]">

                        <div class="absolute inset-0 flex items-end p-6 md:p-8">

                            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white">
                                Nombre de<br />
                                proyecto
                            </h2>

                        </div>

                    </div>


                    <div class="mt-5 flex items-start justify-between gap-6">

                        <div>

                            <h3 class="text-xl md:text-2xl font-bold">
                                Nombre de proyecto
                            </h3>

                            <p class="mt-2 text-sm text-neutral-500">
                                Descripción del proyecto
                            </p>

                        </div>


                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5 text-[#0066FF] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                            aria-hidden="true"
                        >
                            <path d="M7 17 17 7" />
                            <path d="M7 7h10v10" />
                        </svg>

                    </div>


                    <div class="mt-5 border-b border-[#292929] group-hover:border-[#0066FF] transition-colors duration-300"></div>

                </a>


                <a href="/works" class="group block">

                    <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-[#292929]">

                        <div class="absolute inset-0 flex items-end p-6 md:p-8">

                            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white">
                                Nombre de<br />
                                proyecto
                            </h2>

                        </div>

                    </div>


                    <div class="mt-5 flex items-start justify-between gap-6">

                        <div>

                            <h3 class="text-xl md:text-2xl font-bold">
                                Nombre de proyecto
                            </h3>

                            <p class="mt-2 text-sm text-neutral-500">
                                Descripción del proyecto
                            </p>

                        </div>


                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5 text-[#0066FF] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                            aria-hidden="true"
                        >
                            <path d="M7 17 17 7" />
                            <path d="M7 7h10v10" />
                        </svg>

                    </div>


                    <div class="mt-5 border-b border-[#292929] group-hover:border-[#0066FF] transition-colors duration-300"></div>

                </a>

            </div>

        </div>

    </section>


    <!-- CONTACTO -->

    <section
        id="contact"
        class="reveal-on-scroll bg-black text-white px-6 md:px-12 lg:px-20 pt-12 md:pt-16 pb-10 md:pb-12"
    >

        <div class="max-w-[1400px] mx-auto">

            <div class="mb-7 md:mb-8">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Contacto
                </p>

            </div>


            <h2 class="text-[clamp(3.5rem,9vw,8rem)] font-bold max-w-6xl">

                Hablemos
                <br />

                de tu próximo
                <br />

                proyecto.

            </h2>


            <div class="mt-8 md:mt-10 flex flex-col md:flex-row md:items-end md:justify-between gap-6">

                <p class="max-w-xl text-lg md:text-xl leading-relaxed text-neutral-400">
                    Si tienes una idea, un proyecto o simplemente quieres
                    contarme qué tienes entre manos, escríbeme.
                </p>


                <a
                    href="/contact"
                    class="group inline-flex items-center gap-4 text-white text-base md:text-lg font-medium"
                    aria-label="Cuéntame tu idea"
                >

                    <span class="border-b border-white pb-1 group-hover:border-[#0066FF] transition-colors">
                        Cuéntame tu idea
                    </span>

                    <span class="w-10 h-10 rounded-full bg-[#0066FF] flex items-center justify-center group-hover:scale-110 transition-transform">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="w-5 h-5"
                            aria-hidden="true"
                        >
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>

                    </span>

                </a>

            </div>

        </div>

    </section>


    <script>
        const revealElements = document.querySelectorAll(".reveal-on-scroll");

        if ("IntersectionObserver" in window) {
            const revealObserver = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-visible");
                            revealObserver.unobserve(entry.target);
                        }
                    });
                },
                {
                    threshold: 0.08,
                    rootMargin: "0px 0px -80px 0px",
                }
            );

            revealElements.forEach((element) => {
                revealObserver.observe(element);
            });
        } else {
            revealElements.forEach((element) => {
                element.classList.add("is-visible");
            });
        }
    </script>

</Layout>
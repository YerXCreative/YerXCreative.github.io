---
// layout
import Layout from '../layouts/Layout.astro';

// assets
import peter from "../assets/images/peter.jpg";
---

<Layout 
    title="Yeray Díaz - Diseñador Gráfico y Web"
    description="Director de Arte y Diseñador Gráfico."
>
    <!-- HEADER -->
    <header class="w-full py-6 px-12 flex justify-center items-center" style="background-color: #2d1b4e;">
        <nav class="flex gap-8 text-sm font-medium">
            <a href="/" class="px-4 py-2 rounded" style="background-color: #ccff00; color: #2d1b4e;">Home</a>
            <a href="/works" class="text-white hover:text-[#ccff00]">Work</a>
            <a href="/about" class="text-white hover:text-[#ccff00]">Resumé</a>
        </nav>
    </header>

    <!-- SECCIÓN 1: HOLA -->
    <section class="w-full py-16 px-6 md:px-24" style="background-color: #2d1b4e;">
        <div class="max-w-6xl mx-auto">
            <h1 class="text-5xl md:text-7xl font-bold mb-12 text-center" style="color: #ccff00;">
                ¡Hola! Soy Yeray
            </h1>
            
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="text-white text-lg leading-relaxed space-y-6">
                    <p>
                        Soy Yeray Díaz, un Diseñador Gráfico y Web. Me especializo en crear identidades visuales y experiencias digitales que ayudan a las marcas a destacar.
                    </p>
                    <p>
                        A lo largo de mi carrera, he colaborado con grandes empresas y startups, trabajando en todo, desde campañas integrales hasta proyectos de alto impacto.
                    </p>
                </div>
                
                <div class="flex justify-center">
                    <div class="w-full max-w-md aspect-[3/4] overflow-hidden rounded-lg">
                        <img src={peter.src} alt="Yeray Díaz" class="w-full h-full object-cover" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: NO SO
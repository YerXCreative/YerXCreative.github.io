---
import Layout from "../../layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

export const getStaticPaths = (async () => {
    const works = await getCollection("works", ({ data }) => !data.isDraft);

    return [
        {
            params: {
                page: undefined,
            },
            props: {
                works,
            },
        },
    ];
}) satisfies GetStaticPaths;

const { works } = Astro.props;

const imageModules = import.meta.glob(
    "../../content/images/**/*.{jpg,jpeg,png,webp,avif}",
    {
        eager: true,
        import: "default",
    }
);

const getProjectImages = (slug: string) => {
    return Object.entries(imageModules)
        .filter(([path]) => path.includes(`/images/${slug}/`))
        .sort(([pathA], [pathB]) => {
            const fileA = pathA.split("/").pop() ?? "";
            const fileB = pathB.split("/").pop() ?? "";

            const numberA = parseInt(fileA, 10);
            const numberB = parseInt(fileB, 10);

            if (!Number.isNaN(numberA) && !Number.isNaN(numberB)) {
                return numberA - numberB;
            }

            return fileA.localeCompare(fileB);
        })
        .map(([, image]) => image as ImageMetadata);
};
---

<Layout
    title="Proyectos | YerxCreative"
    description="Una selección de proyectos de Yeray Díaz en diseño web, campañas digitales e identidad visual."
>

    <main class="bg-black text-white px-6 md:px-12 lg:px-20 pt-28 md:pt-32 pb-16">

        <div class="max-w-[1400px] mx-auto">

            <!-- CABECERA -->

            <header class="mb-20 md:mb-28">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-500 mb-6">
                    YerxCreative / Proyectos
                </p>

                <div class="border-t border-[#292929] pt-8">

                    <h1 class="text-[clamp(5rem,12vw,11rem)] font-bold uppercase max-w-6xl">
                        Proyectos.
                    </h1>

                    <p class="mt-8 max-w-2xl text-lg md:text-xl text-neutral-400 leading-relaxed">
                        Una selección de trabajos en diseño web,
                        campañas digitales, identidad visual
                        y proyectos creativos.
                    </p>

                </div>

            </header>


            <!-- PORTFOLIO -->

            <section
                aria-label="Proyectos seleccionados"
                class="[&>article:last-child]:mb-0"
            >

                {works.map((work, projectIndex) => {

                    const images = getProjectImages(work.data.slug);
                    const visibleImages = images.slice(0, 4);

                    return (
                        <article class="border-t border-[#292929] pt-10 md:pt-12 mb-28 md:mb-36">

                            <!-- CABECERA DEL PROYECTO -->

                            <header class="grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr] gap-8 md:gap-16 mb-10 md:mb-12">

                                <div>

                                    <p class="text-[#0066FF] text-xs uppercase tracking-[0.18em] font-semibold mb-4">
                                        {work.data.category}
                                    </p>

                                    <h2 class="text-5xl md:text-7xl lg:text-[7rem] font-bold uppercase">
                                        {work.data.title}
                                    </h2>

                                </div>


                                <div class="md:pt-2">

                                    <div class="flex flex-wrap gap-x-8 gap-y-3 text-xs uppercase tracking-[0.15em] text-neutral-500 mb-7">

                                        <span>
                                            {work.data.client}
                                        </span>

                                        <span>
                                            {work.data.year}
                                        </span>

                                        <span>
                                            {work.data.services}
                                        </span>

                                    </div>

                                    <p class="max-w-2xl text-lg md:text-xl text-neutral-400 leading-relaxed">
                                        {work.data.description}
                                    </p>

                                </div>

                            </header>


                            <!-- IMÁGENES DEL PROYECTO -->

                            {visibleImages.length > 0 && (
                                <div class="max-w-5xl mx-auto">

                                    <!-- 1 IMAGEN -->

                                    {visibleImages.length === 1 && (
                                        <div class="max-w-[520px] mx-auto">

                                            <button
                                                type="button"
                                                class="group block w-full cursor-zoom-in border-0 bg-transparent p-0"
                                                data-lightbox-image={visibleImages[0].src}
                                                data-lightbox-alt={`${work.data.title} — imagen 1`}
                                                aria-label={`Ampliar imagen 1 de ${work.data.title}`}
                                            >

                                                <div class="w-full aspect-[4/3] overflow-hidden bg-[#0A0A0A]">

                                                    <img
                                                        src={visibleImages[0].src}
                                                        alt={`${work.data.title} — imagen 1`}
                                                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.015]"
                                                        loading={projectIndex === 0 ? "eager" : "lazy"}
                                                    />

                                                </div>

                                            </button>

                                        </div>
                                    )}


                                    <!-- 2 IMÁGENES -->

                                    {visibleImages.length === 2 && (
                                        <div class="grid grid-cols-2 gap-0">

                                            {visibleImages.map((image, imageIndex) => (

                                                <button
                                                    type="button"
                                                    class="group block w-full cursor-zoom-in border-0 bg-transparent p-0"
                                                    data-lightbox-image={image.src}
                                                    data-lightbox-alt={`${work.data.title} — imagen ${imageIndex + 1}`}
                                                    aria-label={`Ampliar imagen ${imageIndex + 1} de ${work.data.title}`}
                                                >

                                                    <div class="w-full aspect-[4/3] overflow-hidden bg-[#0A0A0A]">

                                                        <img
                                                            src={image.src}
                                                            alt={`${work.data.title} — imagen ${imageIndex + 1}`}
                                                            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.015]"
                                                            loading={projectIndex === 0 ? "eager" : "lazy"}
                                                        />

                                                    </div>

                                                </button>

                                            ))}

                                        </div>
                                    )}


                                    <!-- 3 IMÁGENES -->

                                    {visibleImages.length === 3 && (
                                        <div class="grid grid-cols-2 gap-0">

                                            {visibleImages.slice(0, 2).map((image, imageIndex) => (

                                                <button
                                                    type="button"
                                                    class="group block w-full cursor-zoom-in border-0 bg-transparent p-0"
                                                    data-lightbox-image={image.src}
                                                    data-lightbox-alt={`${work.data.title} — imagen ${imageIndex + 1}`}
                                                    aria-label={`Ampliar imagen ${imageIndex + 1} de ${work.data.title}`}
                                                >

                                                    <div class="w-full aspect-[4/3] overflow-hidden bg-[#0A0A0A]">

                                                        <img
                                                            src={image.src}
                                                            alt={`${work.data.title} — imagen ${imageIndex + 1}`}
                                                            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.015]"
                                                            loading={projectIndex === 0 ? "eager" : "lazy"}
                                                        />

                                                    </div>

                                                </button>

                                            ))}


                                            <button
                                                type="button"
                                                class="group block w-full max-w-[50%] mx-auto col-span-2 cursor-zoom-in border-0 bg-transparent p-0"
                                                data-lightbox-image={visibleImages[2].src}
                                                data-lightbox-alt={`${work.data.title} — imagen 3`}
                                                aria-label={`Ampliar imagen 3 de ${work.data.title}`}
                                            >

                                                <div class="w-full aspect-[4/3] overflow-hidden bg-[#0A0A0A]">

                                                    <img
                                                        src={visibleImages[2].src}
                                                        alt={`${work.data.title} — imagen 3`}
                                                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.015]"
                                                        loading="lazy"
                                                    />

                                                </div>

                                            </button>

                                        </div>
                                    )}


                                    <!-- 4 IMÁGENES -->

                                    {visibleImages.length >= 4 && (
                                        <div class="grid grid-cols-2 gap-0">

                                            {visibleImages.map((image, imageIndex) => (

                                                <button
                                                    type="button"
                                                    class="group block w-full cursor-zoom-in border-0 bg-transparent p-0"
                                                    data-lightbox-image={image.src}
                                                    data-lightbox-alt={`${work.data.title} — imagen ${imageIndex + 1}`}
                                                    aria-label={`Ampliar imagen ${imageIndex + 1} de ${work.data.title}`}
                                                >

                                                    <div class="w-full aspect-[4/3] overflow-hidden bg-[#0A0A0A]">

                                                        <img
                                                            src={image.src}
                                                            alt={`${work.data.title} — imagen ${imageIndex + 1}`}
                                                            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.015]"
                                                            loading={projectIndex === 0 ? "eager" : "lazy"}
                                                        />

                                                    </div>

                                                </button>

                                            ))}

                                        </div>
                                    )}

                                </div>
                            )}


                            <!-- ENTRAR AL PROYECTO -->

                            <div class="mt-10 md:mt-12 flex justify-end">

                                <a
                                    href={`/works/${work.data.slug}`}
                                    class="group inline-flex items-center gap-4 text-white text-sm font-semibold"
                                >

                                    <span class="border-b border-white pb-1 group-hover:border-[#0066FF] group-hover:text-[#0066FF] transition-colors">
                                        Ver proyecto completo
                                    </span>

                                    <span class="w-10 h-10 rounded-full border border-[#292929] flex items-center justify-center group-hover:border-[#0066FF] transition-colors">

                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1.8"
                                            class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                                            aria-hidden="true"
                                        >
                                            <path d="M7 17L17 7" />
                                            <path d="M7 7h10v10" />
                                        </svg>

                                    </span>

                                </a>

                            </div>

                        </article>
                    );
                })}

            </section>

        </div>

    </main>


    <!-- LIGHTBOX -->

    <div
        id="image-lightbox"
        class="fixed inset-0 z-[100] hidden bg-black/95 p-6 md:p-10 items-center justify-center"
        aria-hidden="true"
    >

        <button
            id="lightbox-close"
            type="button"
            class="absolute top-5 right-5 md:top-8 md:right-8 w-12 h-12 rounded-full border border-white/20 bg-transparent text-white flex items-center justify-center hover:border-[#0066FF] hover:text-[#0066FF] transition-colors duration-200"
            aria-label="Cerrar imagen"
        >

            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="w-5 h-5"
                aria-hidden="true"
            >
                <path d="M6 6l12 12" />
                <path d="M18 6L6 18" />
            </svg>

        </button>


        <img
            id="lightbox-image"
            src=""
            alt=""
            class="max-w-full max-h-[90vh] w-auto h-auto object-contain"
        />

    </div>


    <script>
        const lightbox = document.getElementById("image-lightbox");
        const lightboxImage = document.getElementById("lightbox-image");
        const closeButton = document.getElementById("lightbox-close");
        const imageButtons = document.querySelectorAll("[data-lightbox-image]");

        const openLightbox = (image, alt) => {
            if (!lightbox || !lightboxImage) return;

            lightboxImage.src = image;
            lightboxImage.alt = alt || "";

            lightbox.classList.remove("hidden");
            lightbox.classList.add("flex");
            lightbox.setAttribute("aria-hidden", "false");

            document.body.style.overflow = "hidden";
        };

        const closeLightbox = () => {
            if (!lightbox || !lightboxImage) return;

            lightbox.classList.add("hidden");
            lightbox.classList.remove("flex");
            lightbox.setAttribute("aria-hidden", "true");

            lightboxImage.src = "";
            document.body.style.overflow = "";
        };

        imageButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const image = button.getAttribute("data-lightbox-image");
                const alt = button.getAttribute("data-lightbox-alt");

                if (image) {
                    openLightbox(image, alt);
                }
            });
        });

        closeButton?.addEventListener("click", closeLightbox);

        lightbox?.addEventListener("click", (event) => {
            if (event.target === lightbox) {
                closeLightbox();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                closeLightbox();
            }
        });
    </script>

</Layout>
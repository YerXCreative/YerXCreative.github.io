---
// components
import Container from "../../elements/Container.astro"
import ContactItem from "./ContactItem.astro"
import Heading from "../../elements/Heading.astro"
import Text from "../../elements/Text.astro"
---

<Container variant={'md'} class="flex flex-col gap-16 py-8">
    <!-- Tus datos de contacto existentes -->
    <div class="flex lg:flex-row flex-col gap-8 text-base-900 justify-center">
        <ContactItem title="Email" contact="yerxcreativestudio@gmail.com" />
        <ContactItem title="Instagram" contact="@Yerxcreative" />
    </div>

    <!-- Nuevo Formulario de Contacto -->
    <div class="w-full max-w-2xl mx-auto">
        <Heading tagName="h2" tagSize="h3" class="text-center mb-8">Envíame un mensaje</Heading>
        
        <!-- El action apunta a formsubmit.co con tu email -->
        <form 
            action="https://formsubmit.co/yerxcreativestudio@gmail.com" 
            method="POST" 
            class="flex flex-col gap-6"
        >
            <!-- Configuración oculta para Formsubmit -->
            <input type="hidden" name="_subject" value="Nuevo mensaje desde YerxCreative!">
            <input type="hidden" name="_next" value="https://yerxcreative.github.io/gracias">
            <input type="hidden" name="_captcha" value="false">

            <!-- Campo Nombre -->
            <div class="flex flex-col gap-2">
                <label for="name" class="text-sm font-semibold text-white">Nombre</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required
                    class="w-full px-4 py-3 rounded-lg border border-gray-600 bg-white text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white focus:border-transparent transition"
                    placeholder="Tu nombre"
                    style="color: #111111 !important;"
                />
            </div>

            <!-- Campo Email -->
            <div class="flex flex-col gap-2">
                <label for="email" class="text-sm font-semibold text-white">Correo electrónico</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required
                    class="w-full px-4 py-3 rounded-lg border border-gray-600 bg-white text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white focus:border-transparent transition"
                    placeholder="tu@email.com"
                    style="color: #111111 !important;"
                />
            </div>

            <!-- Campo Mensaje -->
            <div class="flex flex-col gap-2">
                <label for="message" class="text-sm font-semibold text-white">Mensaje</label>
                <textarea 
                    id="message" 
                    name="message" 
                    rows="5" 
                    required
                    class="w-full px-4 py-3 rounded-lg border border-gray-600 bg-white text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white focus:border-transparent transition resize-none"
                    placeholder="Cuéntame sobre tu proyecto..."
                    style="color: #111111 !important;"
                ></textarea>
            </div>

            <!-- Botón de Enviar -->
            <button 
                type="submit" 
                class="w-full md:w-auto px-8 py-3 bg-white text-gray-900 font-semibold rounded-lg hover:bg-gray-200 transition duration-300 cursor-pointer"
            >
                Enviar Mensaje
            </button>
        </form>
    </div>
</Container>
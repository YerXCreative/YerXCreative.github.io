---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import Dropdown from "../../elements/Dropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

// content
const services = [
    { 
        title: "Branding e Identidad Visual",
        text: "Desarrollo la identidad gráfica integral de tu marca: desde la creación de logotipos hasta sistemas visuales completos y guías de estilo para construir una presencia sólida y reconocible."
    },
    { 
        title: "Diseño y Desarrollo Web",
        text: "Diseño y desarrollo sitios web funcionales y atractivos utilizando herramientas como WordPress y Elementor, adaptados a todos los dispositivos y optimizados para conectar con tu audiencia."
    },
    { 
        title: "Contenido Digital y Publicidad",
        text: "Creación de piezas gráficas para redes sociales, campañas publicitarias digitales (Meta Ads) y recursos multimedia potenciados con herramientas de Inteligencia Artificial para destacar en el entorno digital."
    },
    { 
        title: "Diseño Editorial y Artes Finales",
        text: "Maquetación de publicaciones impresas y digitales (revistas, cartelería, folletos, packaging), garantizando la preparación adecuada de los archivos y artes finales para su correcta producción e impresión."
    },
]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Servicios</Heading>
    <div class="flex flex-col gap-4">
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                services.map((service, index) => (
                    <Dropdown title=`${index + 1}. ${service.title}` text={service.text} />  
                ))
            }       
        </Container>
        <ContainerBottom />    
    </div>

</Container>
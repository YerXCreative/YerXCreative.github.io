```astro
---
const navLinks = [
    { title: "Home", href: "/" },
    { title: "Work", href: "/works" },
    { title: "About", href: "/about" },
    { title: "Contact", href: "#contact" }
];
---

<nav class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-2rem)] max-w-5xl">
    <div class="bg-black/70 backdrop-blur-xl border border-white/10 rounded-full px-4 py-3 md:px-5 md:py-3 flex items-center justify-between gap-4 shadow-2xl">

        <!-- Logo -->
        <a
            href="/"
            class="text-white font-bold tracking-[-0.03em] text-sm md:text-base whitespace-nowrap hover:opacity-100"
        >
            YerxCreative
        </a>


        <!-- Navegación -->
        <ul class="hidden md:flex items-center gap-1">

            {navLinks.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class="text-white/70 px-4 py-2 rounded-full text-sm font-medium hover:text-white hover:bg-white/10 transition-all duration-200"
                    >
                        {link.title}
                    </a>
                </li>
            ))}

        </ul>


        <!-- Botón contacto -->
        <a
            href="#contact"
            aria-label="Ir a contacto"
            class="w-9 h-9 md:w-10 md:h-10 rounded-full bg-[#0066FF] text-white flex items-center justify-center hover:scale-105 hover:bg-[#1687FF] transition-all duration-200 shrink-0"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="w-4 h-4 md:w-5 md:h-5"
            >
                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
            </svg>
        </a>

    </div>
</nav>
```

---
import Layout from "../../layouts/Layout.astro";
import "../../styles/markdown.css";

import type { GetStaticPaths } from "astro";
import type { ImageMetadata } from "astro";
import { render, getCollection } from "astro:content";

import ImageContainer from "../../components/elements/ImageContainer.astro";

export const getStaticPaths = (async () => {
    const works = await getCollection("works", ({ data }) => !data.isDraft);

    return works.map((work) => ({
        params: {
            page: work.data.slug,
        },
        props: {
            work,
        },
    }));
}) satisfies GetStaticPaths;

const { work } = Astro.props;

const { Content } = await render(work);

const {
    title,
    client,
    category,
    services,
    year,
    description,
} = work.data;


/*
 * Busca automáticamente todas las imágenes del proyecto.
 *
 * Ejemplo:
 *
 * src/content/images/play-to-die/
 * ├── 1.jpg
 * ├── 2.jpg
 * ├── 3.jpg
 * └── 4.jpg
 */

const imageModules = import.meta.glob(
    "../../content/images/**/*.{jpg,jpeg,png,webp,avif}",
    {
        eager: true,
        import: "default",
    }
);

const projectImages = Object.entries(imageModules)
    .filter(([path]) => {
        return path.includes(`/images/${work.data.slug}/`);
    })
    .sort(([pathA], [pathB]) => {
        const fileA = pathA.split("/").pop() ?? "";
        const fileB = pathB.split("/").pop() ?? "";

        const numberA = parseInt(fileA, 10);
        const numberB = parseInt(fileB, 10);

        if (!Number.isNaN(numberA) && !Number.isNaN(numberB)) {
            return numberA - numberB;
        }

        return fileA.localeCompare(fileB);
    })
    .map(([, image]) => image as ImageMetadata);
---

<Layout
    title={`${title} | YerxCreative`}
    description={description}
>

    <main class="bg-black text-white px-6 md:px-12 lg:px-20 pt-28 md:pt-32 pb-12 md:pb-16">

        <div class="max-w-[1400px] mx-auto">


            <!-- CABECERA -->

            <header class="mb-14 md:mb-20">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-500 mb-6">
                    YerxCreative / Proyectos
                </p>

                <div class="border-t border-[#292929] pt-8">

                    <p class="text-[#0066FF] text-xs md:text-sm uppercase tracking-[0.18em] font-semibold mb-5">
                        {category}
                    </p>

                    <h1 class="text-[clamp(5rem,12vw,11rem)] font-bold uppercase max-w-6xl">
                        {title}
                    </h1>

                </div>

            </header>


            <!-- IMÁGENES DEL PROYECTO -->

            {projectImages.length > 0 && (

                <section class="mb-14 md:mb-20 space-y-6 md:space-y-8">

                    {projectImages.map((image, index) => (

                        <div class="w-full overflow-hidden bg-[#0A0A0A]">

                            <ImageContainer
                                src={image}
                                alt={`${title} — imagen ${index + 1}`}
                                class="w-full h-auto"
                            />

                        </div>

                    ))}

                </section>

            )}


            <!-- INFORMACIÓN DEL PROYECTO -->

            <section class="border-t border-[#292929] py-8 md:py-10">

                <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-6">


                    <div>

                        <p class="text-xs uppercase tracking-[0.15em] text-neutral-500 mb-2">
                            Cliente
                        </p>

                        <p class="text-white text-base md:text-lg">
                            {client}
                        </p>

                    </div>


                    <div>

                        <p class="text-xs uppercase tracking-[0.15em] text-neutral-500 mb-2">
                            Categoría
                        </p>

                        <p class="text-white text-base md:text-lg">
                            {category}
                        </p>

                    </div>


                    <div>

                        <p class="text-xs uppercase tracking-[0.15em] text-neutral-500 mb-2">
                            Servicios
                        </p>

                        <p class="text-white text-base md:text-lg">
                            {services}
                        </p>

                    </div>


                    <div>

                        <p class="text-xs uppercase tracking-[0.15em] text-neutral-500 mb-2">
                            Año
                        </p>

                        <p class="text-white text-base md:text-lg">
                            {year}
                        </p>

                    </div>

                </div>

            </section>


            <!-- DESCRIPCIÓN -->

            <section class="py-16 md:py-20">

                <div class="grid grid-cols-1 md:grid-cols-[0.7fr_1.3fr] gap-8 md:gap-20">

                    <div>

                        <p class="text-xs uppercase tracking-[0.18em] text-neutral-500">
                            El proyecto
                        </p>

                    </div>


                    <div>

                        <p class="text-3xl md:text-5xl lg:text-6xl font-bold leading-[1] text-white max-w-5xl">
                            {description}
                        </p>

                    </div>

                </div>

            </section>


            <!-- CONTENIDO DEL PROYECTO -->

            <article class="markdown-content max-w-4xl mx-auto py-8 md:py-12">

                <Content />

            </article>


            <!-- VOLVER -->

            <section class="mt-12 md:mt-16 border-t border-[#292929] pt-8">

                <a
                    href="/works"
                    class="group inline-flex items-center gap-3 text-white font-semibold"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-5 h-5 group-hover:-translate-x-1 transition-transform"
                        aria-hidden="true"
                    >
                        <path d="M19 12H5" />
                        <path d="m11 18-6-6 6-6" />
                    </svg>

                    <span class="border-b border-white pb-1 group-hover:border-[#0066FF] transition-colors">
                        Todos los proyectos
                    </span>

                </a>

            </section>

        </div>

    </main>

</Layout>
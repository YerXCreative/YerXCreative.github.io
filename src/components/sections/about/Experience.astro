---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import ResumeDropdown from "../../elements/ResumeDropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

// content
const experience = [
    { 
        title: "Diseñador Gráfico & Identidad Visual",
        place: "Freelance",
        period: "2022 - Actualidad",
        text: "Desarrollo de identidades visuales, branding y piezas de comunicación para marcas y proyectos que buscan definir y mejorar su presencia visual."
    }, 
    { 
        title: "Diseñador de Branding",
        place: "Proyectos de Identidad Visual",
        period: "2020 - 2022",
        text: "Creación de conceptos visuales, logotipos y sistemas de identidad coherentes, adaptados a las necesidades y personalidad de cada proyecto."
    }, 
    { 
        title: "Diseñador Gráfico & Web",
        place: "Proyectos Freelance",
        period: "2018 - 2020",
        text: "Diseño de materiales gráficos y propuestas visuales para medios digitales e impresos, incluyendo páginas web y contenido para redes sociales."
    }, 
    { 
        title: "Diseñador Gráfico",
        place: "Proyectos Creativos",
        period: "2017 - 2018",
        text: "Desarrollo de piezas gráficas, composiciones visuales y recursos de comunicación, trabajando desde la idea inicial hasta el resultado final."
    },
]

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Experiencia</Heading>
    <div class="flex flex-col gap-4">  
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                experience.map((i) => (
                    <ResumeDropdown title={i.title} place={i.place} period={i.period} text={i.text} />
                ))
            }
        </Container>
        <ContainerBottom />
    </div>

</Container>

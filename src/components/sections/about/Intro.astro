---
import peter3 from "../../../assets/images/peter3.jpg";
---

<section class="bg-black text-white">

    <!-- CABECERA -->

    <div class="px-6 md:px-12 lg:px-20 pt-20 md:pt-28">

        <div class="max-w-[1400px] mx-auto">

            <header>

                <p class="uppercase tracking-[0.2em] text-sm text-neutral-500 mb-8">
                    YerxCreative / Sobre mí
                </p>

                <div class="pt-2">

                    <h1 class="font-bold uppercase max-w-6xl leading-[0.82] tracking-[-0.02em]">
                        <span class="block text-[clamp(5rem,11vw,10rem)]">
                            SOBRE
                        </span>

                        <span class="block text-[clamp(5rem,11vw,10rem)] text-[#0066FF]">
                            MÍ
                        </span>
                    </h1>

                </div>

            </header>

        </div>

    </div>


    <!-- PRESENTACIÓN -->

    <section class="px-6 md:px-12 lg:px-20 pt-24 md:pt-28 pb-24 md:pb-32">

        <div class="max-w-[1400px] mx-auto grid grid-cols-2 gap-20 lg:gap-28 items-start">

            <!-- TEXTO -->

            <div class="flex flex-col gap-8 md:gap-10">

                <p class="text-3xl md:text-5xl leading-[1.05] text-white max-w-3xl">
                    Diseño, proyectos y creatividad.
                </p>

                <p class="text-lg md:text-xl leading-relaxed text-neutral-400 max-w-2xl">
                    Soy Yeray Díaz Cortina, diseñador digital y de proyectos.
                    Trabajo en diseño web, campañas digitales, identidad visual
                    y gestión de proyectos.
                </p>

                <p class="text-lg md:text-xl leading-relaxed text-neutral-400 max-w-2xl">
                    Me interesa crear soluciones que funcionen, que tengan
                    personalidad y que sean capaces de convertir una idea
                    en algo que la gente pueda entender y recordar.
                </p>

            </div>


            <!-- IMAGEN -->

            <div class="flex justify-end">

                <div class="relative w-full max-w-[520px]">

                    <div class="absolute right-[-10px] bottom-[-10px] w-full h-full border-r-2 border-b-2 border-[#0066FF] rounded-[28px]">
                    </div>

                    <div class="relative overflow-hidden rounded-[28px]">

                        <img
                            src={peter3.src}
                            alt="Yeray Díaz Cortina, diseñador digital y de proyectos"
                            class="w-full h-auto object-cover"
                        />

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- LO QUE HAGO -->

    <section class="px-6 md:px-12 lg:px-20 py-24 md:py-32">

        <div class="max-w-[1400px] mx-auto">

            <div class="grid grid-cols-[0.7fr_1.3fr] gap-20">

                <div>

                    <p class="uppercase tracking-[0.2em] text-sm text-neutral-500">
                        Lo que hago
                    </p>

                </div>


                <div>

                    <div>

                        <div class="py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Identidad visual
                            </h2>
                        </div>

                        <div class="py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Diseño web
                            </h2>
                        </div>

                        <div class="py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Campañas digitales
                            </h2>
                        </div>

                        <div class="py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Diseño gráfico
                            </h2>
                        </div>

                        <div class="py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Gestión de proyectos
                            </h2>
                        </div>

                        <div class="py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Cliente y comunicación
                            </h2>
                        </div>

                        <div class="py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                Herramientas creativas
                            </h2>
                        </div>

                        <div class="py-7 border-b border-[#292929]">
                            <h2 class="text-4xl md:text-5xl">
                                IA aplicada al diseño
                            </h2>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CIERRE -->

    <section class="px-6 md:px-12 lg:px-20 pt-12 md:pt-16 pb-12 md:pb-16">

        <div class="max-w-[1400px] mx-auto">

            <div>

                <p class="text-5xl md:text-7xl lg:text-8xl leading-[0.92] max-w-6xl">
                    Diseño con intención.
                </p>

                <p class="text-5xl md:text-7xl lg:text-8xl leading-[0.92] max-w-6xl text-[#0066FF]">
                    Creatividad con criterio.
                </p>

            </div>

        </div>

    </section>

</section>
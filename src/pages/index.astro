---
// layout
import Layout from '../layouts/Layout.astro';
import peter from "../assets/images/peter.jpg";
---

<Layout 
    title="Yeray Díaz - Diseñador Gráfico y Web"
    description="Director de Arte y Diseñador Gráfico."
>
    <!-- HEADER -->
    <header style="width: 100%; padding: 24px 48px; display: flex; justify-content: center; align-items: center; background-color: #2d1b4e;">
        <nav style="display: flex; gap: 32px; font-size: 14px; font-weight: 500;">
            <a href="/" style="padding: 8px 16px; border-radius: 4px; background-color: #ccff00; color: #2d1b4e;">Home</a>
            <a href="/works" style="color: white;">Work</a>
            <a href="/about" style="color: white;">Resumé</a>
        </nav>
    </header>

    <!-- SECCIÓN 1: HOLA -->
    <section style="width: 100%; padding: 64px 24px; background-color: #2d1b4e;">
        <div style="max-width: 1200px; margin: 0 auto;">
            <h1 style="font-size: 3rem; font-weight: 700; margin-bottom: 48px; text-align: center; color: #ccff00;">
                ¡Hola! Soy Yeray
            </h1>
            
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 48px; align-items: center;">
                <div style="color: white; font-size: 18px; line-height: 1.6;">
                    <p style="margin-bottom: 24px;">
                        Soy Yeray Díaz, un Diseñador Gráfico y Web. Me especializo en crear identidades visuales y experiencias digitales que ayudan a las marcas a destacar.
                    </p>
                    <p>
                        A lo largo de mi carrera, he colaborado con grandes empresas y startups, trabajando en todo, desde campañas integrales hasta proyectos de alto impacto.
                    </p>
                </div>
                
                <div style="display: flex; justify-content: center;">
                    <img src={peter.src} alt="Yeray Díaz" style="width: 100%; max-width: 400px; height: 500px; object-fit: cover; border-radius: 8px;" />
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: NO SOY ROBOT -->
    <section style="width: 100%; padding: 64px 24px; background-color: #2d1b4e;">
        <div style="max-width: 800px; margin: 0 auto;">
            <h2 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 32px; color: #ccff00;">
                No soy un robot.
            </h2>
            <p style="color: white; font-size: 18px; line-height: 1.6;">
                Por eso aporto un toque humano a cada proyecto, combinando creatividad estratégica con las últimas herramientas de Inteligencia Artificial.
            </p>
        </div>
    </section>

    <!-- SECCIÓN 3: DATOS -->
    <section style="width: 100%; padding: 64px 24px; background-color: #2d1b4e;">
        <div style="max-width: 800px; margin: 0 auto;">
            <h2 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 32px; color: #ccff00;">
                Otros datos sobre mí.
            </h2>
            <ul style="color: white; font-size: 18px; line-height: 2;">
                <li>• Amante del diseño minimalista</li>
                <li>• Adicto a la cafeína</li>
                <li>• Entusiasta de la tecnología</li>
                <li>• Creo en el buen diseño</li>
            </ul>
        </div>
    </section>

    <!-- FOOTER -->
    <footer style="width: 100%; padding: 64px 24px; background-color: #7c3aed;">
        <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; text-align: center;">
            <div>
                <h3 style="font-size: 20px; font-weight: 600; margin-bottom: 8px; color: #00ffff;">Phone</h3>
                <p style="color: white; font-size: 14px;">+34 600 000 000</p>
            </div>
            <div>
                <h3 style="font-size: 20px; font-weight: 600; margin-bottom: 8px; color: #00ffff;">Email</h3>
                <p style="color: white; font-size: 14px;">yerxcreativestudio@gmail.com</p>
            </div>
            <div>
                <h3 style="font-size: 20px; font-weight: 600; margin-bottom: 8px; color: #00ffff;">Connect</h3>
                <div style="display: flex; justify-content: center; gap: 16px; color: white; font-size: 14px;">
                    <a href="https://www.instagram.com/yerxcreative/" style="color: white;">Instagram</a>
                    <a href="https://www.threads.com/@yerxcreative" style="color: white;">Threads</a>
                </div>
            </div>
        </div>
    </footer>
</Layout>
---
import "../styles/global.css";
import BaseHead from "../components/global/BaseHead.astro";
import Wrapper from "../components/global/Wrapper.astro";
import NavBar from "../components/global/Navigation.astro";

const {title, description, ...seoProps} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <BaseHead title={title} description={description} {...seoProps} />
    <body class="min-h-screen">
        <Wrapper>
            <NavBar />
            <main>
                <slot />
            </main>
            <!-- Footer eliminado - ahora cada página tiene su propio footer -->
        </Wrapper>
    </body>
</html>
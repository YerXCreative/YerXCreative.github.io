---
import Seo, { type Props as SEOProps } from "../../components/global/Seo.astro";

const SITE_NAME = "YerxCreative";
const TITLE_TMPL = "%s | YerxCreative";
const DEFAULT_OG = "/og-image.png";
const TWITTER_SITE = "@yerxcreative";
const THEME_COLOR = "#000000";
const LOCALE = "es_ES";

export interface Props extends SEOProps {
    /** Extra <head> content injected after SEO tags (optional). */
    headSlot?: boolean;
}

const {
    title,
    description,
    titleTemplate = TITLE_TMPL,
    siteName = SITE_NAME,
    ogImage = DEFAULT_OG,
    twitterSite = TWITTER_SITE,
    themeColor = THEME_COLOR,
    locale = LOCALE,
    ...seoProps
} = Astro.props;
---

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <meta
        name="theme-color"
        content={themeColor}
    />

    <link rel="icon" href="/favicon.ico" />

    <link
        rel="sitemap"
        href="/sitemap-index.xml"
    />

    <meta
        name="generator"
        content={Astro.generator}
    />

    <Seo
        title={title}
        description={description}
        titleTemplate={titleTemplate}
        siteName={siteName}
        ogImage={ogImage}
        twitterSite={twitterSite}
        themeColor={themeColor}
        locale={locale}
        {...seoProps}
    />

</head>
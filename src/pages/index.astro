---
import Layout from '../layouts/Layout.astro';
import peter from "../assets/images/peter.jpg";
---

<Layout
    title="Yeray Díaz — Diseñador Digital"
    description="Portfolio de Yeray Díaz, diseñador digital y de proyectos."
>

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section class="relative bg-black text-white min-h-screen flex flex-col justify-between px-6 md:px-12 lg:px-20 pt-32 pb-8 overflow-hidden">

        <div class="max-w-[1400px] mx-auto w-full flex items-center justify-between text-[10px] md:text-xs uppercase tracking-[0.2em] text-neutral-500">

            <span>
                Diseñador digital & proyectos
            </span>

            <span class="hidden sm:block">
                Gijón · Asturias
            </span>

        </div>


        <div class="max-w-[1400px] mx-auto w-full flex-1 flex items-center py-16 md:py-20">

            <div>

                <div class="flex items-center gap-4 mb-8">

                    <span class="w-2 h-2 rounded-full bg-[#0066FF]"></span>

                    <p class="text-[#0066FF] text-sm md:text-base font-bold uppercase tracking-[0.2em]">
                        Hola, soy Yeray
                    </p>

                </div>


                <h1 class="text-[clamp(4rem,11vw,10rem)] leading-[0.82] font-bold tracking-[-0.07em] uppercase max-w-[1300px]">

                    Diseño
                    <br />

                    digital que
                    <br />

                    <span class="text-neutral-500">
                        no parece
                    </span>

                    <br />

                    hecho por un robot.

                </h1>

            </div>

        </div>


        <div class="max-w-[1400px] mx-auto w-full flex flex-col md:flex-row md:items-end justify-between gap-10">

            <p class="max-w-lg text-base md:text-lg text-neutral-400 leading-relaxed">
                Diseño, web, campañas y proyectos digitales
                con una mezcla bastante seria de creatividad,
                estrategia y criterio.
            </p>


            <a
                href="#about-preview"
                aria-label="Bajar a sobre mí"
                class="group flex items-center gap-4"
            >

                <span class="hidden md:block text-xs uppercase tracking-[0.2em] text-neutral-500">
                    Conóceme
                </span>

                <span class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-[#0066FF] text-white flex items-center justify-center group-hover:scale-110 transition-transform">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="w-6 h-6 md:w-7 md:h-7"
                    >
                        <path d="M12 5v14" />
                        <path d="m19 12-7 7-7-7" />
                    </svg>

                </span>

            </a>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- SOBRE MÍ + FOTO -->
    <!-- ========================================================= -->

    <section
        id="about-preview"
        class="bg-black text-white px-6 md:px-12 lg:px-20 py-20 md:py-32"
    >

        <div class="max-w-[1400px] mx-auto">

            <div class="mb-14 md:mb-20">

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Hola, soy Yeray
                </p>

            </div>


            <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-24 items-center">

                <!-- Texto -->

                <div>

                    <h2 class="text-5xl md:text-7xl lg:text-[7rem] font-bold leading-[0.86] tracking-[-0.06em] mb-10">

                        Diseño.
                        <br />

                        Proyectos.
                        <br />

                        Personas.

                    </h2>


                    <div class="max-w-xl space-y-6 text-lg md:text-xl leading-relaxed text-neutral-400">

                        <p>
                            Soy Yeray Díaz, diseñador digital y de proyectos.
                        </p>

                        <p>
                            Trabajo en diseño web, campañas digitales,
                            identidad visual y gestión de proyectos,
                            llevando las ideas desde el briefing hasta la entrega.
                        </p>

                        <p>
                            Me interesa que las cosas funcionen,
                            pero también que tengan algo que decir.
                        </p>

                    </div>

                </div>


                <!-- Foto -->

                <div class="relative rounded-3xl">

                    <div class="absolute -top-4 -left-4 w-full h-full border-2 border-[#0066FF] rounded-3xl"></div>

                    <div class="relative bg-[#0A0A0A] p-3 rounded-3xl border border-neutral-800 overflow-hidden">

                        <img
                            src={peter.src}
                            alt="Yeray Díaz, diseñador digital y de proyectos"
                            class="w-full h-auto object-cover rounded-2xl"
                        />

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
<!-- LO QUE HAGO -->
<!-- ========================================================= -->

<section class="bg-black text-white px-6 md:px-12 lg:px-20 py-20 md:py-32">

    <div class="max-w-[1400px] mx-auto">

        <!-- Cabecera -->
        <div class="flex items-start justify-between mb-16 md:mb-20">

            <span class="text-[#0066FF] font-bold text-sm md:text-base">
                03
            </span>

            <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                Lo que hago
            </p>

        </div>


        <!-- Servicios -->

        <div class="border-t border-neutral-800">

            <!-- 01 -->
            <div class="grid grid-cols-[60px_1fr] md:grid-cols-[100px_1fr] items-center py-8 md:py-10 border-b border-neutral-800">

                <span class="text-[#0066FF] text-sm md:text-base font-bold">
                    01
                </span>

                <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-[-0.04em]">
                    Identidad visual
                </h3>

            </div>


            <!-- 02 -->
            <div class="grid grid-cols-[60px_1fr] md:grid-cols-[100px_1fr] items-center py-8 md:py-10 border-b border-neutral-800">

                <span class="text-[#0066FF] text-sm md:text-base font-bold">
                    02
                </span>

                <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-[-0.04em]">
                    Diseño web
                </h3>

            </div>


            <!-- 03 -->
            <div class="grid grid-cols-[60px_1fr] md:grid-cols-[100px_1fr] items-center py-8 md:py-10 border-b border-neutral-800">

                <span class="text-[#0066FF] text-sm md:text-base font-bold">
                    03
                </span>

                <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-[-0.04em]">
                    Campañas digitales
                </h3>

            </div>


            <!-- 04 -->
            <div class="grid grid-cols-[60px_1fr] md:grid-cols-[100px_1fr] items-center py-8 md:py-10 border-b border-neutral-800">

                <span class="text-[#0066FF] text-sm md:text-base font-bold">
                    04
                </span>

                <h3 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-[-0.04em]">
                    Gestión de proyectos
                </h3>

            </div>

        </div>

    </div>

</section>


    <!-- ========================================================= -->
<!-- SELECTED WORK -->
<!-- ========================================================= -->

<section
    id="selected-work"
    class="bg-black text-white px-6 md:px-12 lg:px-20 py-20 md:py-32"
>

    <div class="max-w-[1400px] mx-auto">

        <!-- Cabecera -->

        <div class="flex items-start justify-between mb-16 md:mb-20">

            <span class="text-[#0066FF] font-bold text-sm md:text-base">
                04
            </span>

            <div class="text-right">
                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-400">
                    Selected work
                </p>

                <p class="mt-2 text-sm text-neutral-600">
                    Algunos proyectos y trabajos
                </p>
            </div>

        </div>


        <!-- Proyectos -->

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-16 md:gap-y-20">


            <!-- Proyecto 01 -->

            <a href="/works" class="group block">

                <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-neutral-800">

                    <span class="absolute top-5 right-5 text-[#0066FF] text-sm font-bold z-10">
                        01
                    </span>

                    <div class="absolute inset-0 flex items-end p-6 md:p-8">

                        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.05em] leading-[0.9] text-white">
                            Nombre de<br />
                            proyecto
                        </h2>

                    </div>

                </div>

                <div class="mt-5 flex items-start justify-between gap-6">

                    <div>
                        <h3 class="text-xl md:text-2xl font-bold tracking-[-0.03em]">
                            Nombre de proyecto
                        </h3>

                        <p class="mt-2 text-sm text-neutral-500">
                            Descripción del proyecto
                        </p>
                    </div>

                    <span class="text-[#0066FF] text-sm font-bold">
                        01
                    </span>

                </div>

            </a>


            <!-- Proyecto 02 -->

            <a href="/works" class="group block">

                <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-neutral-800">

                    <span class="absolute top-5 right-5 text-[#0066FF] text-sm font-bold z-10">
                        02
                    </span>

                    <div class="absolute inset-0 flex items-end p-6 md:p-8">

                        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.05em] leading-[0.9] text-white">
                            Nombre de<br />
                            proyecto
                        </h2>

                    </div>

                </div>

                <div class="mt-5 flex items-start justify-between gap-6">

                    <div>
                        <h3 class="text-xl md:text-2xl font-bold tracking-[-0.03em]">
                            Nombre de proyecto
                        </h3>

                        <p class="mt-2 text-sm text-neutral-500">
                            Descripción del proyecto
                        </p>
                    </div>

                    <span class="text-[#0066FF] text-sm font-bold">
                        02
                    </span>

                </div>

            </a>


            <!-- Proyecto 03 -->

            <a href="/works" class="group block">

                <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-neutral-800">

                    <span class="absolute top-5 right-5 text-[#0066FF] text-sm font-bold z-10">
                        03
                    </span>

                    <div class="absolute inset-0 flex items-end p-6 md:p-8">

                        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.05em] leading-[0.9] text-white">
                            Nombre de<br />
                            proyecto
                        </h2>

                    </div>

                </div>

                <div class="mt-5 flex items-start justify-between gap-6">

                    <div>
                        <h3 class="text-xl md:text-2xl font-bold tracking-[-0.03em]">
                            Nombre de proyecto
                        </h3>

                        <p class="mt-2 text-sm text-neutral-500">
                            Descripción del proyecto
                        </p>
                    </div>

                    <span class="text-[#0066FF] text-sm font-bold">
                        03
                    </span>

                </div>

            </a>


            <!-- Proyecto 04 -->

            <a href="/works" class="group block">

                <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A] border border-neutral-800">

                    <span class="absolute top-5 right-5 text-[#0066FF] text-sm font-bold z-10">
                        04
                    </span>

                    <div class="absolute inset-0 flex items-end p-6 md:p-8">

                        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.05em] leading-[0.9] text-white">
                            Nombre de<br />
                            proyecto
                        </h2>

                    </div>

                </div>

                <div class="mt-5 flex items-start justify-between gap-6">

                    <div>
                        <h3 class="text-xl md:text-2xl font-bold tracking-[-0.03em]">
                            Nombre de proyecto
                        </h3>

                        <p class="mt-2 text-sm text-neutral-500">
                            Descripción del proyecto
                        </p>
                    </div>

                    <span class="text-[#0066FF] text-sm font-bold">
                        04
                    </span>

                </div>

            </a>


        </div>

    </div>

</section>


    <!-- ========================================================= -->
    <!-- CONTACTO -->
    <!-- ========================================================= -->

    <section
        id="contact"
        class="bg-black text-white px-6 md:px-12 lg:px-20 pt-24 md:pt-32 pb-16"
    >

        <div class="max-w-[1400px] mx-auto">

            <p class="text-[#0066FF] uppercase tracking-[0.2em] text-sm font-bold mb-8">
                ¿Hablamos?
            </p>

            <h2 class="text-[clamp(3.5rem,9vw,8rem)] leading-[0.85] font-bold tracking-[-0.06em] max-w-6xl">
                Hablemos
                <br />
                de tu próximo
                <br />
                proyecto.
            </h2>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- FOOTER -->
    <!-- ========================================================= -->

    <footer class="bg-black border-t border-[#0066FF]">

        <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20 py-8">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">

                <!-- Marca -->

                <div class="flex items-center gap-2 shrink-0">

                    <span class="text-white font-bold text-lg tracking-[-0.03em]">
                        YerxCreative
                    </span>

                    <span class="text-neutral-500 text-sm">
                        © {new Date().getFullYear()}
                    </span>

                </div>


                <!-- Botones -->

                <div class="flex flex-wrap items-center gap-3">

                    <!-- WhatsApp -->

                    <a
                        href="https://wa.me/34697601146?text=Hola%20Yeray%2C%20me%20gustar%C3%ADa%20hablar%20contigo%20sobre%20un%20proyecto.%20%C2%BFPodemos%20comentar%20los%20detalles%3F"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 rounded-full border border-[#0066FF] px-4 py-2.5 text-sm text-white hover:bg-[#0066FF] transition-colors"
                    >
                        WhatsApp

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="w-4 h-4"
                        >
                            <path d="M20.52 3.48A11.86 11.86 0 0 0 12.07 0C5.51 0 .17 5.34.17 11.9c0 2.1.55 4.15 1.6 5.96L.1 24l6.28-1.64a11.88 11.88 0 0 0 5.69 1.45h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.16-3.46-8.43ZM12.08 21.8h-.01a9.88 9.88 0 0 1-5.04-1.38l-.36-.21-3.73.98.99-3.64-.23-.37a9.88 9.88 0 1 1 8.38 4.62Zm5.42-7.4c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.69.15-.2.3-.79.98-.97 1.18-.2.2-.36.22-.66.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.64-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.36.45-.54.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.69-1.66-.94-2.28-.25-.6-.5-.52-.69-.53h-.59c-.2 0-.52.37-.79.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.1 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.07-.12-.27-.2-.57-.35Z" />
                        </svg>

                    </a>


                    <!-- Email -->

                    <a
                        href="https://mail.google.com/mail/?view=cm&fs=1&to=yeraydxz@gmail.com&su=Empecemos%20tu%20proyecto&body=Hola%20Yeray%2C%0A%0AMe%20gustar%C3%ADa%20hablar%20contigo%20sobre%20un%20proyecto."
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 rounded-full border border-[#0066FF] px-4 py-2.5 text-sm text-white hover:bg-[#0066FF] transition-colors"
                    >
                        Email

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-4 h-4"
                        >
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="M3 7l9 6 9-6" />
                        </svg>

                    </a>


                    <!-- Instagram -->

                    <a
                        href="https://instagram.com/yerxcreative"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center rounded-full border border-[#0066FF] px-4 py-2.5 text-sm text-white hover:bg-[#0066FF] transition-colors"
                    >
                        Instagram
                    </a>


                    <!-- Threads -->

                    <a
                        href="https://threads.com/@yerxcreative"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center rounded-full border border-[#0066FF] px-4 py-2.5 text-sm text-white hover:bg-[#0066FF] transition-colors"
                    >
                        Threads
                    </a>

                </div>


                <!-- Firma -->

                <span class="text-neutral-500 text-sm shrink-0">
                    Diseñado por Yeray Díaz
                </span>

            </div>

        </div>

    </footer>

</Layout>
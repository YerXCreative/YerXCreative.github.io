---
const whatsappMessage =
    "Hola Yeray, me gustaría hablar contigo sobre un proyecto. ¿Podemos comentar los detalles?";
const whatsappUrl = `https://wa.me/34697601146?text=${encodeURIComponent(whatsappMessage)}`;
---

<footer class="relative left-1/2 -translate-x-1/2 w-screen bg-black text-white border-t border-[#292929] mt-7">
    <div class="max-w-6xl mx-auto px-6 py-8">

        <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-10">

            <!-- Marca -->
            <div class="text-center">
                <div class="flex items-center justify-center gap-2">
                    <span class="font-bold text-lg">
                        YerxCreative
                    </span>

                    <span class="text-sm text-neutral-500">
                        © {new Date().getFullYear()}
                    </span>
                </div>
            </div>

            <!-- Botones -->
            <div class="flex items-center gap-3">

                <!-- WhatsApp -->
                <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 px-4 py-2 rounded-full border border-[#292929] text-sm text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors duration-200"
                    aria-label="Contactar por WhatsApp"
                >
                    <span>WhatsApp</span>

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-4 h-4"
                        aria-hidden="true"
                    >
                        <path d="M20 11.5a8 8 0 0 1-11.8 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z" />
                        <path d="M8.5 9.5c.3 1.5 2.5 3.7 4 4 .5.1 1-.1 1.3-.6l.4-.6c.1-.2.1-.4-.1-.5l-1.4-.7c-.2-.1-.4 0-.5.2l-.4.5c-.8-.3-1.5-1-1.8-1.8l.5-.4c.2-.1.3-.3.2-.5l-.7-1.4c-.1-.2-.3-.2-.5-.1l-.6.4c-.5.3-.7.8-.6 1.3Z" />
                    </svg>
                </a>

                <!-- Email -->
                <a
                    href="mailto:yeraydxz@gmail.com"
                    class="flex items-center gap-2 px-4 py-2 rounded-full border border-[#292929] text-sm text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors duration-200"
                    aria-label="Enviar email"
                >
                    <span>Email</span>

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-4 h-4"
                        aria-hidden="true"
                    >
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m3 7 9 6 9-6" />
                    </svg>
                </a>

                <!-- Instagram -->
                <a
    href="https://instagram.com/yerxcreative"
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 px-4 py-2 rounded-full border border-[#292929] text-sm text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors duration-200"
    aria-label="Instagram"
>
    <span>Instagram</span>

    <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="w-4 h-4"
        aria-hidden="true"
    >
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
    </svg>
</a>

                <!-- Threads -->
             <a
    href="https://threads.com/@yerxcreative"
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 px-4 py-2 rounded-full border border-[#292929] text-sm text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors duration-200"
    aria-label="Threads"
>
    <span>Threads</span>

    <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="w-4 h-4"
        aria-hidden="true"
    >
        <path d="M17.8 11.2c-.2-3.3-2.1-5.2-5.5-5.2-3.6 0-5.8 2-5.8 5.5 0 3.8 2.3 6 5.9 6 3.3 0 5.4-1.6 5.4-4.1 0-2.2-1.7-3.5-4.5-3.5-2.4 0-3.8 1-3.8 2.6 0 1.4 1.1 2.3 2.8 2.3 1.8 0 3-.9 3-2.5 0-3.8-2.2-5.8-5.6-5.8" />
    </svg>
</a>

            </div>

            <!-- Firma -->
            <span class="text-sm text-neutral-500 text-center">
                Diseñado por Yeray Díaz
            </span>

        </div>

    </div>
</footer>
---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import ResumeDropdown from "../../elements/ResumeDropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

// content
const education = [
    { 
        title: "CFGS Diseño y Edición de Publicaciones Impresas y Multimedia",
        place: "Emilio Alarcos · Gijón",
        period: "2023 - 2025",
        text: "Formación especializada en diseño gráfico, comunicación visual, producción gráfica, diseño editorial y desarrollo de proyectos para medios impresos y digitales."
    },
    { 
        title: "Curso Avanzado de Photoshop",
        place: "ITC · Gijón",
        period: "2025",
        text: "Formación avanzada en retoque y edición de imagen, composición y creación de recursos gráficos para diferentes proyectos de comunicación visual."
    }
    { 
        title: "Bachillerato Humanidades
y Ciencias Sociales",
        place: "IES Calderón de la Barca · Gijón",
        period: "2018 – 2022",
    } 

]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Formación</Heading>
    <div class="flex flex-col gap-4">
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                education.map((i) => (
                    <ResumeDropdown title={i.title} place={i.place} period={i.period} text={i.text} />
                ))
            }
        </Container>
        <ContainerBottom /> 
    </div>
    
</Container>

                        rel="noopener noreferrer"
                        aria-label="Contactar por WhatsApp"
                        class="w-12 h-12 rounded-full border border-[#292929] flex items-center justify-center text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5"
                            aria-hidden="true"
                        >
                            <path d="M20.52 3.48A11.86 11.86 0 0 0 12.07 0C5.51 0 .17 5.34.17 11.9c0 2.1.55 4.15 1.6 5.96L.1 24l6.28-1.64a11.88 11.88 0 0 0 5.69 1.45h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.16-3.46-8.43ZM12.08 21.8h-.01a9.88 9.88 0 0 1-5.04-1.38l-.36-.21-3.73.98.99-3.64-.23-.37a9.88 9.88 0 1 1 8.38 4.62Zm5.42-7.4c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.69.15-.2.3-.79.98-.97 1.18-.2.2-.36.22-.66.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.64-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.36.45-.54.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.69-1.66-.94-2.28-.25-.6-.5-.52-.69-.53h-.59c-.2 0-.52.37-.79.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.1 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.07-.12-.27-.2-.57-.35Z"
                            />
                        </svg>
                    </a>


                    <!-- INSTAGRAM -->
                    <a
                        href="https://www.instagram.com/yerxcreative/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                        class="w-12 h-12 rounded-full border border-[#292929] flex items-center justify-center text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5"
                            aria-hidden="true"
                        >
                            <rect x="3" y="3" width="18" height="18" rx="5" />
                            <circle cx="12" cy="12" r="4" />
                            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                        </svg>
                    </a>


                    <!-- THREADS -->
                    <a
                        href="https://www.threads.com/@yerxcreative?hl=es"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Threads"
                        class="w-12 h-12 rounded-full border border-[#292929] flex items-center justify-center text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-5 h-5"
                            aria-hidden="true"
                        >
                            <path d="M19.1 8.9c-.3-3.2-2.2-5.1-5.5-5.5-3.4-.4-6.4.8-7.9 3.5" />
                            <path d="M5.7 6.9c-.2 3.3 1.8 5.1 5.1 5.1 3.2 0 5.5 1.2 5.5 3.5 0 2.1-1.8 3.5-4.7 3.5-3.5 0-5.8-2-5.8-5.7 0-4.4 3-7.7 7.5-7.7 4.8 0 7.8 2.9 7.8 7.8 0 4.3-2.8 7.1-7.3 7.1-3.8 0-6.4-1.7-7.4-4.8" />
                        </svg>
                    </a>

                </div>

            </div>


            <!-- FIRMA -->
            <div class="mt-16 pt-6 border-t border-[#292929] flex flex-col md:flex-row md:items-center md:justify-between gap-3">

                <span class="text-white font-bold tracking-[-0.03em]">
                    YerxCreative
                </span>

                <span class="text-neutral-500 text-sm">
                    Diseñado por Yeray Díaz · © {new Date().getFullYear()}
                </span>

            </div>

        </div>

    </div>

</section>
---
const whatsappMessage =
    "Hola Yeray, me gustaría hablar contigo sobre un proyecto. ¿Podemos comentar los detalles?";

const whatsappUrl = `https://wa.me/34697601146?text=${encodeURIComponent(whatsappMessage)}`;
---

<footer class="relative left-1/2 -translate-x-1/2 w-screen bg-black text-white border-t border-[#292929]">

    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-7 sm:py-8">

        <div class="flex flex-col md:flex-row items-center justify-between gap-6">


            <!-- MARCA -->

            <div class="flex items-center gap-3">

                <span class="font-bold text-base sm:text-lg">
                    YerxCreative
                </span>

                <span class="text-xs sm:text-sm text-neutral-600">
                    © {new Date().getFullYear()}
                </span>

            </div>


            <!-- ICONOS -->

            <div class="flex items-center gap-2.5 sm:gap-3">


                <!-- WHATSAPP -->

                <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Contactar por WhatsApp"
                    class="w-10 h-10 rounded-full border border-[#292929] flex items-center justify-center text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors duration-200"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-4.5 h-4.5"
                        aria-hidden="true"
                    >
                        <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z" />
                        <path d="M8.5 8.5c.3-.4.6-.4.9-.1l1 1.1c.2.2.2.5 0 .8l-.5.6c.6 1.1 1.5 2 2.6 2.6l.6-.5c.3-.2.6-.2.8 0l1.1 1c.3.3.3.6-.1.9-.5.5-1.2.7-1.8.5-2.1-.6-4.8-3.3-5.4-5.4-.2-.6 0-1.3.5-1.8Z" />
                    </svg>

                </a>


                <!-- EMAIL -->

                <a
                    href="mailto:yeraydxz@gmail.com"
                    aria-label="Enviar email"
                    class="w-10 h-10 rounded-full border border-[#292929] flex items-center justify-center text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors duration-200"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-4.5 h-4.5"
                        aria-hidden="true"
                    >
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m3 7 9 6 9-6" />
                    </svg>

                </a>


                <!-- INSTAGRAM -->

                <a
                    href="https://instagram.com/yerxcreative"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram"
                    class="w-10 h-10 rounded-full border border-[#292929] flex items-center justify-center text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors duration-200"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-4.5 h-4.5"
                        aria-hidden="true"
                    >
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                    </svg>

                </a>


                <!-- THREADS -->

                <a
                    href="https://threads.com/@yerxcreative"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Threads"
                    class="w-10 h-10 rounded-full border border-[#292929] flex items-center justify-center text-white hover:border-[#0066FF] hover:text-[#0066FF] transition-colors duration-200"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="w-4.5 h-4.5"
                        aria-hidden="true"
                    >
                        <path d="M18.5 10.5c-.2-3.5-2.4-5.5-5.9-5.5-3.7 0-6.1 2.2-6.1 5.7 0 4 2.7 7.2 6.5 7.2 3.1 0 5.2-1.7 5.2-4.3 0-2.2-1.5-3.6-3.8-3.6-2.1 0-3.5 1.1-3.5 2.7 0 1.4 1 2.3 2.4 2.3 1.5 0 2.7-1 3-2.5" />
                        <path d="M12.1 12.7c3.8 0 6.2 1.2 7.1 3.7" />
                    </svg>

                </a>

            </div>


            <!-- FIRMA -->

            <span class="text-xs sm:text-sm text-neutral-500 text-center">
                Diseñado por Yeray Díaz
            </span>

        </div>

    </div>

</footer>
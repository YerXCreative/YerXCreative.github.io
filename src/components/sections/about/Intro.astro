---
import peter3 from "../../../assets/images/peter3.jpg";
---

<section class="bg-black text-white">

    <!-- CABECERA -->

    <div class="px-5 sm:px-6 md:px-12 lg:px-20 pt-16 sm:pt-20 md:pt-32">

        <div class="max-w-[1400px] mx-auto">

            <header>

                <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-500 mb-5 md:mb-6">
                    YerxCreative / Sobre mí
                </p>

                <div class="border-t border-[#292929] pt-6 sm:pt-7 md:pt-8">

                    <h1 class="text-[clamp(4.5rem,18vw,9rem)] sm:text-[clamp(5rem,14vw,9rem)] md:text-[clamp(4rem,10vw,9rem)] font-bold max-w-6xl leading-[1]">
                        Soy Yeray.
                    </h1>

                </div>

            </header>

        </div>

    </div>


    <!-- PRESENTACIÓN -->

    <section class="px-5 sm:px-6 md:px-12 lg:px-20 py-16 sm:py-20 md:py-28">

        <div class="max-w-[1400px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 lg:gap-28 items-start">

            <!-- TEXTO -->

            <div class="flex flex-col gap-8 md:gap-10">

                <p class="text-2xl sm:text-3xl md:text-4xl leading-[1.15] text-white">
                    Soy diseñador digital y de proyectos.
                </p>

                <p class="text-lg md:text-xl leading-relaxed text-neutral-400 max-w-2xl">
                    Trabajo entre el diseño gráfico, el diseño web y la dirección
                    de proyectos, buscando que las ideas tengan sentido tanto
                    visualmente como cuando salen del papel.
                </p>

                <p class="text-lg md:text-xl leading-relaxed text-neutral-400 max-w-2xl">
                    Me interesa construir identidades con personalidad,
                    experiencias digitales claras y soluciones que funcionen
                    de verdad.
                </p>

            </div>


            <!-- IMAGEN -->

            <div class="flex justify-center md:justify-end">

                <div class="w-full max-w-[520px] border border-[#292929] p-3">

                    <img
                        src={peter3.src}
                        alt="Yeray Díaz, diseñador digital y de proyectos"
                        class="w-full h-auto object-cover"
                    />

                </div>

            </div>

        </div>

    </section>


    <!-- LO QUE SÉ HACER -->

    <section class="px-5 sm:px-6 md:px-12 lg:px-20 py-16 sm:py-20 md:py-28 border-t border-[#292929]">

        <div class="max-w-[1400px] mx-auto">

            <div class="grid grid-cols-1 md:grid-cols-[0.7fr_1.3fr] gap-10 md:gap-20">

                <div>

                    <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-neutral-500">
                        Lo que hago
                    </p>

                </div>


                <div>

                    <div class="border-t border-[#292929]">

                        <div class="py-6 md:py-8 border-b border-[#292929]">
                            <h2 class="text-3xl md:text-5xl">
                                Identidad visual
                            </h2>
                        </div>

                        <div class="py-6 md:py-8 border-b border-[#292929]">
                            <h2 class="text-3xl md:text-5xl">
                                Diseño web
                            </h2>
                        </div>

                        <div class="py-6 md:py-8 border-b border-[#292929]">
                            <h2 class="text-3xl md:text-5xl">
                                Campañas digitales
                            </h2>
                        </div>

                        <div class="py-6 md:py-8 border-b border-[#292929]">
                            <h2 class="text-3xl md:text-5xl">
                                Diseño gráfico
                            </h2>
                        </div>

                        <div class="py-6 md:py-8 border-b border-[#292929]">
                            <h2 class="text-3xl md:text-5xl">
                                Gestión de proyectos
                            </h2>
                        </div>

                        <div class="py-6 md:py-8 border-b border-[#292929]">
                            <h2 class="text-3xl md:text-5xl">
                                Cliente y comunicación
                            </h2>
                        </div>

                        <div class="py-6 md:py-8 border-b border-[#292929]">
                            <h2 class="text-3xl md:text-5xl">
                                Herramientas creativas
                            </h2>
                        </div>

                        <div class="py-6 md:py-8 border-b border-[#292929]">
                            <h2 class="text-3xl md:text-5xl">
                                IA aplicada al diseño
                            </h2>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CIERRE -->

    <section class="px-5 sm:px-6 md:px-12 lg:px-20 py-20 sm:py-24 md:py-32">

        <div class="max-w-[1400px] mx-auto">

            <div class="border-t border-[#292929] pt-8 md:pt-10">

                <p class="text-3xl sm:text-4xl md:text-6xl leading-[1.05] max-w-5xl">
                    Diseño para que las ideas se entiendan,
                    funcionen y tengan algo que decir.
                </p>

            </div>

        </div>

    </section>

</section>